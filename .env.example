# Copy to .env for local use. Never commit real values.
# Only PUBLIC_ variables reach the browser; nothing secret belongs in them.
PUBLIC_SITE_URL=http://localhost:4321

# "development" or "production" (default: "development").
# While "development": all pages receive <meta name="robots" content="noindex, nofollow">
# and robots.txt disallows all crawling. Set to "production" only at public launch.
PUBLIC_SITE_STAGE=development

# true in dev and preview builds; leave unset or false in production (removes /styleguide from the build)
PUBLIC_ENABLE_STYLEGUIDE=true

# Contact form endpoint (decided in Phase 5, see docs/02-engineering/forms-and-integrations.md)
# PUBLIC_FORM_ENDPOINT=
