---
// Minimal in Phase 2. Phase 4 adds SEO tags, nav, footer, cursor and the client router (docs/02-engineering/pages-and-routing.md).
import '../styles/global.css';
import themeInit from '../scripts/theme-init.js?raw';
import jersey20Url from '@fontsource/jersey-20/files/jersey-20-latin-400-normal.woff2?url';
import jakartaUrl from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description?: string | undefined;
  noindex?: boolean | undefined;
}

const { title, description = '', noindex = false } = Astro.props;

const siteStage = import.meta.env.PUBLIC_SITE_STAGE ?? 'development';
const isDevelopment = siteStage !== 'production';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preload" href={jersey20Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jakartaUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline set:html={themeInit} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {isDevelopment ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : noindex ? (
      <meta name="robots" content="noindex" />
    ) : null}
  </head>
  <body>
    <slot />
  </body>
</html>
