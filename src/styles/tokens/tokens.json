{
  "$comment": "Single source of truth for design tokens. Layers: palette (primitive), color (semantic, light and dark), component. References use {group.name}. See docs/02-engineering/tokens-implementation.md.",
  "palette": {
    "lime": "#9FFA62",
    "lime-deep": "#83DF4A",
    "lime-yellow": "#B7F626",
    "sky": "#4BC3FF",
    "coral": "#FF9696",
    "forest": "#0F1F05",
    "warm-grey": "#464544",
    "charcoal": "#3D3D3D",
    "grey-100": "#F1F1F1",
    "grey-150": "#F8F8F8",
    "grey-200": "#E6E6E6",
    "grey-400": "#9A9A9A",
    "grey-600": "#636363",
    "white": "#FFFFFF",
    "black": "#000000",
    "pink": "#FF6AD5",
    "cyan": "#22E3F0",
    "blue": "#2F5BFF",
    "dark-900": "#101010",
    "dark-850": "#181818",
    "dark-800": "#1D1D1D",
    "dark-feature": "#2B2B2B",
    "black-14": "rgba(0, 0, 0, 0.14)",
    "white-16": "rgba(255, 255, 255, 0.16)",
    "white-18": "rgba(255, 255, 255, 0.18)"
  },
  "color": {
    "bg-base": { "light": "{palette.grey-100}", "dark": "{palette.dark-900}" },
    "bg-alt": { "light": "{palette.grey-200}", "dark": "{palette.dark-850}" },
    "bg-surface": { "light": "{palette.grey-150}", "dark": "{palette.dark-800}" },
    "bg-feature": { "light": "{palette.charcoal}", "dark": "{palette.dark-feature}" },
    "bg-card": "{palette.white}",
    "text-primary": { "light": "{palette.black}", "dark": "{palette.grey-100}" },
    "text-muted": { "light": "{palette.grey-600}", "dark": "{palette.grey-400}" },
    "text-muted-on-card": "{palette.grey-600}",
    "text-on-feature": "{palette.white}",
    "text-muted-on-feature": "{palette.grey-200}",
    "text-on-accent": "{palette.black}",
    "text-on-blue": "{palette.white}",
    "accent-primary": "{palette.lime}",
    "accent-secondary-1": "{palette.sky}",
    "accent-secondary-2": "{palette.lime-yellow}",
    "accent-secondary-3": "{palette.pink}",
    "accent-secondary-4": "{palette.cyan}",
    "accent-blue": "{palette.blue}",
    "button-inverse-bg": "{palette.forest}",
    "button-inverse-text": "{palette.lime}",
    "divider": { "light": "{palette.black-14}", "dark": "{palette.white-16}" },
    "divider-on-feature": "{palette.white-18}",
    "chip-outline-text-on-feature": "{color.text-on-feature}",
    "chip-outline-stroke-on-feature": "{color.divider-on-feature}",
    "focus": { "light": "{palette.black}", "dark": "{palette.grey-100}" },
    "focus-on-feature": "{palette.lime}",
    "digit-field": { "light": "{palette.black}", "dark": "{palette.grey-100}" },
    "error": "{palette.coral}"
  },
  "component": {
    "card-bg": "{color.bg-card}",
    "card-text": "{color.text-on-accent}",
    "chip-accent-bg": "{color.accent-primary}",
    "chip-accent-text": "{color.text-on-accent}",
    "chip-filled-bg": "{color.bg-alt}",
    "chip-filled-text": "{color.text-primary}",
    "chip-outline-stroke": "{color.divider}",
    "chip-outline-text-on-feature": "{color.chip-outline-text-on-feature}",
    "chip-outline-stroke-on-feature": "{color.chip-outline-stroke-on-feature}",
    "button-primary-bg": "{color.accent-primary}",
    "button-primary-text": "{color.text-on-accent}",
    "button-inverse-bg": "{color.button-inverse-bg}",
    "button-inverse-text": "{color.button-inverse-text}",
    "tag-bg-1": "{color.accent-secondary-1}",
    "tag-bg-2": "{color.accent-secondary-2}",
    "tag-bg-3": "{color.accent-secondary-3}",
    "tag-bg-4": "{color.accent-secondary-4}",
    "tag-text": "{color.text-on-accent}",
    "stat-tile-bg-a": "{color.accent-primary}",
    "stat-tile-bg-b": "{palette.white}",
    "stat-tile-text": "{color.text-on-accent}"
  },
  "font": {
    "display": "'Jersey 20', ui-monospace, monospace",
    "label": "'Stack Sans Notch Variable', 'Stack Sans Notch', system-ui, sans-serif",
    "body": "'Plus Jakarta Sans Variable', 'Plus Jakarta Sans', system-ui, sans-serif"
  },
  "weight": { "regular": "400", "medium": "500", "semibold": "600", "bold": "700" },
  "text": {
    "display-hero": {
      "font": "display",
      "weight": "400",
      "size": "clamp(104px, 33vw, 440px)",
      "line": "0.8",
      "tracking": "0",
      "element": "h1"
    },
    "display-page": {
      "font": "display",
      "weight": "400",
      "size": "clamp(60px, 13vw, 184px)",
      "line": "0.88",
      "tracking": "0",
      "element": "h1"
    },
    "heading-section": {
      "font": "label",
      "weight": "700",
      "size": "clamp(40px, 8.5vw, 128px)",
      "line": "0.98",
      "tracking": "-0.02em",
      "element": "h2"
    },
    "heading-case": {
      "font": "label",
      "weight": "700",
      "size": "clamp(32px, 4.4vw, 60px)",
      "line": "0.98",
      "tracking": "-0.02em",
      "element": "h2"
    },
    "heading-card": {
      "font": "label",
      "weight": "700",
      "size": "clamp(28px, 3.6vw, 52px)",
      "line": "1",
      "tracking": "-0.02em",
      "element": "h3"
    },
    "heading-row": {
      "font": "label",
      "weight": "700",
      "size": "clamp(22px, 3.6vw, 48px)",
      "line": "1",
      "tracking": "-0.02em",
      "element": "h3"
    },
    "heading-step": {
      "font": "label",
      "weight": "700",
      "size": "clamp(26px, 3vw, 40px)",
      "line": "0.98",
      "tracking": "-0.02em",
      "element": "h3"
    },
    "heading-job": {
      "font": "label",
      "weight": "700",
      "size": "clamp(22px, 2.6vw, 36px)",
      "line": "0.98",
      "tracking": "-0.02em",
      "element": "h3"
    },
    "label": {
      "font": "label",
      "weight": "600",
      "size": "0.95rem",
      "line": "1",
      "tracking": "0",
      "transform": "uppercase",
      "element": "span"
    },
    "stat": {
      "font": "label",
      "weight": "700",
      "size": "clamp(52px, 7.5vw, 112px)",
      "line": "1",
      "tracking": "0",
      "element": "b"
    },
    "statement": {
      "font": "body",
      "weight": "600",
      "size": "clamp(28px, 5.4vw, 76px)",
      "line": "1.02",
      "tracking": "-0.03em",
      "max": "22ch",
      "element": "p"
    },
    "value-text": {
      "font": "body",
      "weight": "500",
      "size": "clamp(20px, 2.6vw, 36px)",
      "line": "1.15",
      "tracking": "-0.02em",
      "max": "34ch",
      "element": "p"
    },
    "email-display": {
      "font": "body",
      "weight": "600",
      "size": "clamp(28px, 7vw, 100px)",
      "line": "1",
      "tracking": "-0.04em",
      "element": "div"
    },
    "body": {
      "font": "body",
      "weight": "400",
      "size": "clamp(16px, 1.2vw, 19px)",
      "line": "1.3",
      "tracking": "-0.02em",
      "max": "60ch",
      "element": "p"
    },
    "body-small": {
      "font": "body",
      "weight": "400",
      "size": "0.9rem",
      "line": "1.3",
      "tracking": "-0.01em",
      "element": "p"
    },
    "chip": {
      "font": "body",
      "weight": "600",
      "size": "0.95rem",
      "line": "1",
      "tracking": "-0.01em",
      "element": "span"
    },
    "tag": {
      "font": "body",
      "weight": "600",
      "size": "clamp(14px, 2.2vw, 28px)",
      "line": "1",
      "tracking": "-0.02em",
      "element": "span"
    },
    "logo-primary": {
      "font": "display",
      "weight": "400",
      "size": "2.2rem",
      "line": "1",
      "tracking": "0",
      "element": "span"
    },
    "logo-secondary": {
      "font": "label",
      "weight": "700",
      "size": "1.5rem",
      "line": "1",
      "tracking": "-0.02em",
      "element": "span"
    },
    "superscript": {
      "font": "label",
      "weight": "700",
      "size": "0.75em",
      "line": "1",
      "tracking": "0",
      "element": "span"
    }
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px",
    "9": "96px",
    "10": "128px"
  },
  "layout": {
    "pad": "clamp(16px, 4vw, 48px)",
    "section-y": "clamp(56px, 9vw, 120px)",
    "section-y-compact": "clamp(24px, 4vw, 48px)",
    "gap": "16px",
    "gap-wide": "24px",
    "nav-height": "72px",
    "columns": "12"
  },
  "stack": {
    "tight": "{space.2}",
    "base": "{space.4}",
    "loose": "{space.6}",
    "section": "{space.7}"
  },
  "measure": {
    "body": "60ch",
    "narrow": "34ch",
    "statement": "22ch"
  },
  "placement": {
    "full": { "start": 1, "span": 12 },
    "statement": { "start": 4, "span": 7 },
    "intro": { "start": 7, "span": 6 },
    "label": { "start": 1, "span": 4 },
    "text": { "start": 5, "span": 8 },
    "half-a": { "start": 1, "span": 6 },
    "half-b": { "start": 7, "span": 6 },
    "meta": { "start": 1, "span": 3 },
    "body": { "start": 4, "span": 9 }
  },
  "radius": { "none": "0", "pill": "999px", "circle": "50%" },
  "line": { "hairline": "1px", "focus-ring": "3px", "focus-offset": "3px", "handle": "3px" },
  "shape": {
    "pixel-blob": "polygon(0 40%, 20% 40%, 20% 20%, 40% 20%, 40% 0, 100% 0, 100% 100%, 40% 100%, 40% 80%, 20% 80%, 20% 60%, 0 60%)",
    "pixel-corner": "polygon(0 0, 100% 0, 100% 60%, 80% 60%, 80% 80%, 60% 80%, 60% 100%, 0 100%)",
    "half-pill-radius": "999px 0 0 999px"
  },
  "z": { "content": "1", "tag": "2", "nav": "20", "safe-area": "30", "cursor": "50" },
  "digit-field": {
    "peak-opacity": "0.45",
    "min-alpha": "0.054",
    "falloff-radius": "240px",
    "flip-radius": "110px",
    "cell-size": "28px",
    "glyph-size": "14px"
  },
  "opacity": { "shape": "0.5", "digit-field": "{digit-field.peak-opacity}" },
  "blur": { "digit-field": "0.7px" },
  "motion": {
    "fast": "250ms",
    "base": "400ms",
    "slow": "800ms",
    "count": "1200ms",
    "stagger": "100ms",
    "float": "3.6s",
    "marquee": "30s",
    "digit-flip": "160ms"
  },
  "ease": { "out": "cubic-bezier(0.2, 0.7, 0.2, 1)", "in-out": "cubic-bezier(0.6, 0, 0.2, 1)" },
  "breakpoint": { "tablet": "721px", "desktop": "1101px" },
  "contrast": [
    { "fg": "text-primary", "bg": "bg-base", "min": 4.5 },
    { "fg": "text-primary", "bg": "bg-alt", "min": 4.5 },
    { "fg": "text-primary", "bg": "bg-surface", "min": 4.5 },
    { "fg": "text-muted", "bg": "bg-base", "min": 4.5 },
    { "fg": "text-muted", "bg": "bg-alt", "min": 4.5 },
    { "fg": "text-muted", "bg": "bg-surface", "min": 4.5 },
    { "fg": "text-muted-on-card", "bg": "bg-card", "min": 4.5 },
    { "fg": "text-on-accent", "bg": "bg-card", "min": 4.5 },
    { "fg": "text-on-feature", "bg": "bg-feature", "min": 4.5 },
    { "fg": "text-muted-on-feature", "bg": "bg-feature", "min": 4.5 },
    { "fg": "chip-outline-text-on-feature", "bg": "bg-feature", "min": 4.5 },
    { "fg": "text-on-accent", "bg": "accent-primary", "min": 4.5 },
    { "fg": "text-on-accent", "bg": "accent-secondary-1", "min": 4.5 },
    { "fg": "text-on-accent", "bg": "accent-secondary-2", "min": 4.5 },
    { "fg": "text-on-accent", "bg": "accent-secondary-3", "min": 4.5 },
    { "fg": "text-on-accent", "bg": "accent-secondary-4", "min": 4.5 },
    { "fg": "text-on-blue", "bg": "accent-blue", "min": 4.5 },
    { "fg": "button-inverse-text", "bg": "button-inverse-bg", "min": 4.5 },
    { "fg": "focus", "bg": "bg-base", "min": 3 },
    { "fg": "focus", "bg": "bg-alt", "min": 3 },
    { "fg": "focus-on-feature", "bg": "bg-feature", "min": 3 },
    { "fg": "text-on-accent", "bg": "error", "min": 4.5 }
  ]
}
