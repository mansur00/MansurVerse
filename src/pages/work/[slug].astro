---
// Case Study page template (/work/[slug]) per docs/01-design/page-specs.md and docs/01-design/layout-system.md.
// Static paths generated from MDX content collection; renders sections C1 to C7.
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/layout-primitives/Section.astro';
import Container from '../../components/layout-primitives/Container.astro';
import Grid from '../../components/layout-primitives/Grid.astro';
import Cell from '../../components/layout-primitives/Cell.astro';
import Stack from '../../components/layout-primitives/Stack.astro';
import Cluster from '../../components/layout-primitives/Cluster.astro';
import SlashLabel from '../../components/primitives/SlashLabel.astro';
import Chip from '../../components/primitives/Chip.astro';
import MetaSidebar from '../../components/content/MetaSidebar.astro';
import ProjectCard from '../../components/content/ProjectCard.astro';
import CompareSlider from '../../components/motion/CompareSlider.astro';
import ProcessBlock from '../../components/blocks/ProcessBlock.astro';
import NumbersBlock from '../../components/blocks/NumbersBlock.astro';
import CTABand from '../../components/layout/CTABand.astro';
import Button from '../../components/primitives/Button.astro';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, allProjects: projects },
  }));
}

const { project, allProjects } = Astro.props;
const { Content, headings } = await render(project);

// Nearest 2 projects by order for "More work"
const otherProjects = allProjects
  .filter((p) => p.id !== project.id)
  .sort(
    (a, b) =>
      Math.abs(a.data.order - project.data.order) - Math.abs(b.data.order - project.data.order),
  )
  .slice(0, 2);

// Next project by order (wrapping to first)
const sortedAll = [...allProjects].sort((a, b) => a.data.order - b.data.order);
const currentIndex = sortedAll.findIndex((p) => p.id === project.id);
const nextProject = sortedAll[(currentIndex + 1) % sortedAll.length];

const sidebarSections = headings.map((h) => ({
  id: h.slug,
  label: h.text,
}));

const sidebarLinks = (project.data.links ?? []).map((l) => ({
  label: l.label,
  href: l.url,
}));
---

<BaseLayout
  title={`${project.data.title} | ${siteConfig.brand.primary}${siteConfig.brand.secondary}`}
  description={project.data.summary}
  ogImage={project.data.cover.image}
  ogType="article"
>
  <!-- C1: Header -->
  <Section surface="base" size="default" class="case-header-section">
    <Container>
      <Stack gap="loose">
        <SlashLabel label="Case study" variant="on-light" />
        <h1 class="case-title text-display-page">{project.data.title}</h1>

        <Cluster gap="tight" class="case-meta-chips">
          <Chip variant="accent">{project.data.category}</Chip>
          <Chip variant="outlined">{String(project.data.year)}</Chip>
          <Chip variant="filled">{project.data.role}</Chip>
        </Cluster>

        <div class="case-hero-art" transition:name={`project-art-${project.id}`}>
          <img
            src={project.data.cover.image}
            alt={project.data.cover.alt}
            class="case-cover-image"
            loading="eager"
          />
        </div>
      </Stack>
    </Container>
  </Section>

  <!-- C2: Body Section with MetaSidebar & MDX Body -->
  <Section surface="base" size="none" class="case-body-section" aria-label="Case Study Details">
    <Container>
      <Grid>
        <Cell placement="meta" from="desktop">
          <aside class="case-sidebar">
            <MetaSidebar
              role={project.data.role}
              year={String(project.data.year)}
              tools={project.data.tools}
              links={sidebarLinks}
              sections={sidebarSections}
            />
          </aside>
        </Cell>

        <Cell placement="body" from="desktop">
          <article class="case-content">
            <Content />
          </article>
        </Cell>
      </Grid>
    </Container>
  </Section>

  <!-- C3: Compare Slider (if project has compare images) -->
  {project.data.compare && (
    <Section
      surface="alt"
      size="default"
      class="case-compare-section"
      aria-label="Before and After Comparison"
    >
      <Container>
        <Stack gap="loose">
          <SlashLabel label="Comparison" variant="on-light" />
          <h2 class="compare-heading text-heading-section">Before and After</h2>
          <CompareSlider
            beforeImage={project.data.compare.before.image}
            afterImage={project.data.compare.after.image}
            beforeLabel={project.data.compare.before.alt}
            afterLabel={project.data.compare.after.alt}
          />
        </Stack>
      </Container>
    </Section>
  )}

  <!-- C4: Results Section -->
  <NumbersBlock
    headingLines={['Measured results', 'and outcomes']}
    lead="Key performance metrics and business impact delivered through this project."
    stats={project.data.results}
  />

  <!-- C5: Process Block -->
  <ProcessBlock surface="alt" />

  <!-- C6: More Work -->
  <Section surface="base" size="default" class="case-more-section" aria-label="More Work">
    <Container>
      <Stack gap="section">
        <SlashLabel label="More work" variant="on-light" />
        <h2 class="more-heading text-heading-section">Selected Projects</h2>
        <div class="more-projects-grid">
          {otherProjects.map((p, idx) => (
            <ProjectCard
              title={p.data.title}
              number={idx + 1}
              description={p.data.summary}
              category={p.data.category}
              year={String(p.data.year)}
              href={`/work/${p.id}`}
              accent={p.data.accent}
              imageSrc={p.data.cover.image}
              imageAlt={p.data.cover.alt}
              variant="grid"
            />
          ))}
        </div>
      </Stack>
    </Container>
  </Section>

  <!-- C7: Next Project Navigation & CTA Band -->
  {nextProject && (
    <Section
      surface="base"
      size="compact"
      class="case-next-section"
      aria-label="Next Project"
      data-pull-next="true"
      data-next-url={`/work/${nextProject.id}`}
    >
      <Container>
        <Stack gap="tight" class="case-next-container">
          <div class="pull-next-meter" aria-hidden="true">
            <div class="pull-next-progress" />
          </div>
          <Button href={`/work/${nextProject.id}`} variant="primary" showArrow={true}>
            Next project: {nextProject.data.title}
          </Button>
        </Stack>
      </Container>
    </Section>
  )}

  <CTABand
    slashLabel={siteConfig.cta.label}
    heading={siteConfig.cta.heading}
    text={siteConfig.cta.text}
    buttonLabel={siteConfig.cta.button.label}
    buttonHref={siteConfig.cta.button.href}
    variant="on-alt"
  />
</BaseLayout>

<style>
  /* C1: Header */
  .case-title {
    margin: 0;
  }

  .case-hero-art {
    margin-top: var(--space-4);
    background: var(--color-bg-surface);
    overflow: hidden;
    width: 100%;
  }

  .case-cover-image {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* C2: Body */
  .case-body-section {
    padding-top: var(--space-6);
    padding-bottom: var(--layout-section-y);
  }

  .case-sidebar {
    position: sticky;
    top: calc(var(--layout-nav-height) + var(--space-6));
    width: 100%;
  }

  .case-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: var(--measure-body, 60ch);
  }

  /* C3: Compare */
  .compare-heading {
    margin: 0;
  }

  /* C6: More Work */
  .more-heading {
    margin: 0;
  }

  .more-projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--layout-gap-wide);
    width: 100%;
  }

  /* C7: Next Project */
  .case-next-container {
    align-items: flex-start;
  }

  .pull-next-meter {
    --pull-progress: 0%;

    width: 220px;
    height: 3px;
    background: var(--color-bg-surface);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .pull-next-progress {
    height: 100%;
    width: var(--pull-progress, 0%);
    background: var(--color-accent-primary);
  }

  @media (width < 900px) {
    .case-sidebar {
      position: static;
    }

    .more-projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<style is:global>
  .case-content h2 {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: var(--text-heading-case-size);
    line-height: var(--text-heading-case-line);
    margin-top: var(--space-8);
    margin-bottom: var(--space-2);
    color: var(--color-text-primary);
  }

  .case-content p {
    font-family: var(--font-body);
    font-size: var(--text-body-size);
    line-height: var(--text-body-line);
    color: var(--color-text-primary);
    margin: 0;
  }
</style>

<script>
  const init = async () => {
    const { initCaseStudyPage } = await import('../../scripts/motion/case-study');
    initCaseStudyPage();
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
  document.addEventListener('astro:page-load', init);
</script>
