---
// Work index page template (/work) per docs/01-design/page-specs.md and docs/01-design/layout-system.md.
// Renders sections W1 to W6: full project index with animated filter and layout toggles.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/layout-primitives/Section.astro';
import Stack from '../../components/layout-primitives/Stack.astro';
import Cluster from '../../components/layout-primitives/Cluster.astro';
import SlashLabel from '../../components/primitives/SlashLabel.astro';
import Chip from '../../components/primitives/Chip.astro';
import SuperscriptNumber from '../../components/primitives/SuperscriptNumber.astro';
import ProjectCard from '../../components/content/ProjectCard.astro';
import CapabilitiesBlock from '../../components/blocks/CapabilitiesBlock.astro';
import ProcessBlock from '../../components/blocks/ProcessBlock.astro';
import CTABand from '../../components/layout/CTABand.astro';
import { siteConfig } from '../../config/site';

// Fetch all projects sorted by order
const allProjects = await getCollection('projects');
const sortedProjects = [...allProjects].sort((a, b) => a.data.order - b.data.order);

// Extract unique categories for filter chips
const rawCategories = Array.from(new Set(allProjects.map((p) => p.data.category)));
const categories = ['All', ...rawCategories];
---

<BaseLayout
  title={`Work | ${siteConfig.brand.primary}${siteConfig.brand.secondary}`}
  description="Explore selected design and engineering projects across product, web, and systems."
>
  <!-- W1: Header & W2: Toolbar -->
  <Section surface="base" size="default" class="work-header-section">
    <Stack gap="section">
      <div class="work-header-top">
        <SlashLabel label="Portfolio" variant="on-light" />
        <h1 class="work-title text-display-page">
          Selected work
          <span class="count-wrapper" aria-live="polite">
            <SuperscriptNumber number={sortedProjects.length} />
          </span>
        </h1>
      </div>

      <div class="work-toolbar">
        <Cluster gap="tight" class="filter-chips">
          <span id="filter-live-count" class="sr-only" aria-live="polite">
            Showing all {sortedProjects.length} projects
          </span>
          {categories.map((cat, idx) => (
            <Chip
              variant={idx === 0 ? 'accent' : 'outlined'}
              as="button"
              data-filter-chip={cat}
              class:list={[{ 'is-active': idx === 0 }]}
            >
              {cat}
            </Chip>
          ))}
        </Cluster>

        <div class="view-toggle" role="group" aria-label="Layout view">
          <button
            type="button"
            class="view-toggle-btn is-active"
            data-view-toggle="grid"
            aria-label="Grid view"
            aria-pressed="true"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <rect x="1" y="1" width="6" height="6"></rect>
              <rect x="9" y="1" width="6" height="6"></rect>
              <rect x="1" y="9" width="6" height="6"></rect>
              <rect x="9" y="9" width="6" height="6"></rect>
            </svg>
          </button>
          <button
            type="button"
            class="view-toggle-btn"
            data-view-toggle="list"
            aria-label="List view"
            aria-pressed="false"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <rect x="1" y="2" width="14" height="2.5"></rect>
              <rect x="1" y="7" width="14" height="2.5"></rect>
              <rect x="1" y="12" width="14" height="2.5"></rect>
            </svg>
          </button>
        </div>
      </div>
    </Stack>
  </Section>

  <!-- W3: Projects Grid -->
  <Section surface="base" size="none" class="projects-grid-section" aria-label="Projects">
    <div class="empty-state" hidden aria-live="polite">
      <p class="empty-state-text text-body">No projects found in this category.</p>
      <button type="button" class="empty-state-reset text-label" data-reset-filter>
        Show all projects
      </button>
    </div>

    <div class="projects-grid">
      {sortedProjects.map((project, idx) => (
        <ProjectCard
          title={project.data.title}
          number={idx + 1}
          description={project.data.summary}
          category={project.data.category}
          year={String(project.data.year)}
          href={`/work/${project.id}`}
          accent={project.data.accent}
          imageSrc={project.data.cover.image}
          imageAlt={project.data.cover.alt}
          variant="grid"
        />
      ))}
    </div>

    <div class="list-preview-follower" aria-hidden="true">
      <img src="" alt="" class="follower-image" />
    </div>
  </Section>

  <!-- W4: Capabilities Block -->
  <CapabilitiesBlock />

  <!-- W5: Process Block -->
  <ProcessBlock surface="alt" />

  <!-- W6: CTA Band -->
  <CTABand
    slashLabel={siteConfig.cta.label}
    heading={siteConfig.cta.heading}
    text={siteConfig.cta.text}
    buttonLabel={siteConfig.cta.button.label}
    buttonHref={siteConfig.cta.button.href}
    variant="on-alt"
  />
</BaseLayout>

<style>
  .work-header-top {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .work-title {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .count-wrapper {
    display: inline-flex;
  }

  .work-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    width: 100%;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
  }

  .view-toggle {
    display: flex;
    gap: var(--space-1);
    background: var(--color-bg-surface);
    padding: var(--space-1);
  }

  .view-toggle-btn {
    all: unset;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      color var(--motion-fast) var(--ease-out),
      background-color var(--motion-fast) var(--ease-out);
  }

  .view-toggle-btn:hover {
    color: var(--color-text-primary);
  }

  .view-toggle-btn.is-active {
    color: var(--color-text-primary);
    background: var(--color-bg-base);
  }

  .projects-grid-section {
    padding-bottom: var(--layout-section-y);
    width: 100%;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--layout-gap-wide);
    width: 100%;
  }

  /* List view layout */
  :global([data-view='list']) .projects-grid {
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (width < 900px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  .empty-state {
    padding: var(--space-12) 0;
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .empty-state[hidden] {
    display: none;
  }

  .empty-state-reset {
    all: unset;
    cursor: pointer;
    color: var(--color-accent-primary);
    text-decoration: underline;
    font-weight: var(--font-weight-bold);
  }

  .list-preview-follower {
    position: fixed;
    top: 0;
    left: 0;
    width: 200px;
    height: 125px;
    pointer-events: none;
    z-index: var(--z-cursor, 999);
    opacity: 0;
    visibility: hidden;
    overflow: hidden;
    transform: translate(-50%, -50%);
  }

  .list-preview-follower.is-active {
    opacity: 1;
    visibility: visible;
  }

  .follower-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>

<script>
  const init = async () => {
    const { initWorkPage } = await import('../../scripts/motion/work');
    initWorkPage();
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
  document.addEventListener('astro:page-load', init);
</script>
