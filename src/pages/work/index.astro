---
// Work catalog index page (/work) per docs/01-design/page-specs.md.
// Shows all projects with category filter chips, grid view, shared blocks and CTA band.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SlashLabel from '../../components/primitives/SlashLabel.astro';
import SuperscriptNumber from '../../components/primitives/SuperscriptNumber.astro';
import Chip from '../../components/primitives/Chip.astro';
import ProjectCard from '../../components/content/ProjectCard.astro';
import CapabilitiesBlock from '../../components/blocks/CapabilitiesBlock.astro';
import ProcessBlock from '../../components/blocks/ProcessBlock.astro';
import CTABand from '../../components/layout/CTABand.astro';
import { siteConfig } from '../../config/site';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);
const categories = ['All', ...siteConfig.categories];
---

<BaseLayout title={`Work | ${siteConfig.brand.primary}${siteConfig.brand.secondary}`}>
  <!-- W1: Header -->
  <section class="work-header-section" aria-label="Work Catalog">
    <div class="work-header-container">
      <SlashLabel label="Work" variant="on-light" />
      <h1 class="work-title text-display-page">
        Work
        <span class="count-wrapper" aria-live="polite">
          <SuperscriptNumber number={sortedProjects.length} />
        </span>
      </h1>

      <!-- W2: Toolbar -->
      <div class="work-toolbar" role="toolbar" aria-label="Project catalog tools">
        <div class="filter-chips" role="group" aria-label="Filter by category">
          {categories.map((cat, idx) => (
            <Chip
              as="button"
              variant={idx === 0 ? 'accent' : 'outlined'}
              active={idx === 0}
              data-filter-chip={cat}
            >
              {cat}
            </Chip>
          ))}
        </div>

        <div class="view-toggle" role="group" aria-label="Layout view">
          <button
            type="button"
            class="view-toggle-btn is-active"
            data-view-toggle="grid"
            aria-label="Grid view"
            aria-pressed="true"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <rect x="1" y="1" width="6" height="6" />
              <rect x="9" y="1" width="6" height="6" />
              <rect x="1" y="9" width="6" height="6" />
              <rect x="9" y="9" width="6" height="6" />
            </svg>
          </button>
          <button
            type="button"
            class="view-toggle-btn"
            data-view-toggle="list"
            aria-label="List view"
            aria-pressed="false"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <rect x="1" y="2" width="14" height="2.5" />
              <rect x="1" y="7" width="14" height="2.5" />
              <rect x="1" y="12" width="14" height="2.5" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- W3: Projects Grid -->
  <section class="projects-grid-section" aria-label="Projects">
    <div class="projects-grid-container">
      <div class="empty-state" hidden aria-live="polite">
        <p class="empty-state-text text-body">No projects found in this category.</p>
        <button type="button" class="empty-state-reset text-label" data-reset-filter>
          Show all projects
        </button>
      </div>

      <div class="projects-grid">
        {sortedProjects.map((project, idx) => (
          <ProjectCard
            title={project.data.title}
            number={idx + 1}
            description={project.data.summary}
            category={project.data.category}
            year={String(project.data.year)}
            href={`/work/${project.id}`}
            accent={project.data.accent}
            imageSrc={project.data.cover.image}
            imageAlt={project.data.cover.alt}
            variant="grid"
          />
        ))}
      </div>

      <div class="list-preview-follower" aria-hidden="true">
        <img src="" alt="" class="follower-image" />
      </div>
    </div>
  </section>

  <!-- W4: Capabilities Block -->
  <CapabilitiesBlock />

  <!-- W5: Process Block -->
  <ProcessBlock surface="alt" />

  <!-- W6: CTA Band -->
  <CTABand
    slashLabel={siteConfig.cta.label}
    heading={siteConfig.cta.heading}
    text={siteConfig.cta.text}
    buttonLabel={siteConfig.cta.button.label}
    buttonHref={siteConfig.cta.button.href}
    variant="on-alt"
  />
</BaseLayout>

<style>
  .work-header-section {
    padding: var(--space-12) var(--layout-page-gutter) var(--space-6);
    background: var(--color-bg-base);
  }

  .work-header-container {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .work-title {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .count-wrapper {
    display: inline-flex;
  }

  .work-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .projects-grid-section {
    padding: var(--space-6) var(--layout-page-gutter) var(--space-12);
    background: var(--color-bg-base);
  }

  .projects-grid-container {
    max-width: var(--layout-max-width);
    margin: 0 auto;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  @media (width < 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  .view-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    background: var(--color-bg-surface);
    border-radius: var(--radius-pill);
    padding: var(--space-1);
  }

  .view-toggle-btn {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      background var(--motion-fast) var(--ease-out),
      color var(--motion-fast) var(--ease-out);
  }

  .view-toggle-btn:hover {
    color: var(--color-text-primary);
  }

  .view-toggle-btn.is-active {
    background: var(--color-accent-primary);
    color: var(--color-text-on-accent);
  }

  .empty-state {
    padding: var(--space-12) 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .empty-state[hidden] {
    display: none !important;
  }

  .empty-state-text {
    margin: 0;
    color: var(--color-text-muted);
  }

  .empty-state-reset {
    all: unset;
    box-sizing: border-box;
    background: var(--color-bg-surface);
    color: var(--color-text-primary);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--text-chip-size);
  }

  .empty-state-reset:hover {
    background: var(--color-accent-primary);
    color: var(--color-text-on-accent);
  }

  .projects-grid-section.is-list-view .projects-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  :global(.projects-grid-section.is-list-view .project-card) {
    grid-template-columns: 1fr !important;
    padding: var(--space-4) var(--space-6) !important;
    background: transparent !important;
    min-height: 0 !important;
  }

  :global(.projects-grid-section.is-list-view .project-card .card-art) {
    display: none !important;
  }

  :global(.projects-grid-section.is-list-view .project-card:hover) {
    background: var(--color-bg-surface) !important;
  }

  .list-preview-follower {
    position: fixed;
    top: 0;
    left: 0;
    width: 200px;
    height: 130px;
    pointer-events: none;
    opacity: 0;
    z-index: var(--z-modal);
    overflow: hidden;
    border-radius: var(--radius-none);
    background: var(--color-bg-surface);
  }

  .follower-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<script>
  const init = async () => {
    const { initWorkPage } = await import('../../scripts/motion/work');
    initWorkPage();
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
  document.addEventListener('astro:page-load', init);
</script>
