---
// Home page (H1 to H11) per docs/01-design/page-specs.md, docs/00-overview/project-brief.md,
// and docs/01-design/layout-system.md.
// Composes only layout primitives, blocks and components; zero <style> block.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout-primitives/Section.astro';
import Grid from '../components/layout-primitives/Grid.astro';
import Cell from '../components/layout-primitives/Cell.astro';
import Stack from '../components/layout-primitives/Stack.astro';
import Cluster from '../components/layout-primitives/Cluster.astro';
import Bleed from '../components/layout-primitives/Bleed.astro';
import SectionHeader from '../components/layout/SectionHeader.astro';
import ProjectCard from '../components/content/ProjectCard.astro';
import StatementText from '../components/content/StatementText.astro';
import Marquee from '../components/content/Marquee.astro';
import KeywordTag from '../components/primitives/KeywordTag.astro';
import Button from '../components/primitives/Button.astro';
import CapabilitiesBlock from '../components/blocks/CapabilitiesBlock.astro';
import ProcessBlock from '../components/blocks/ProcessBlock.astro';
import ValuesBlock from '../components/blocks/ValuesBlock.astro';
import NumbersBlock from '../components/blocks/NumbersBlock.astro';
import CTABand from '../components/layout/CTABand.astro';
import homeData from '../content/home.json';
import capabilitiesData from '../content/capabilities.json';
import { siteConfig } from '../config/site';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const marqueeItems = capabilitiesData.items.map((item, idx) => ({
  name: item.title,
  number: idx + 1,
}));

const statementWords = homeData.statement.text.split(' ');
---

<BaseLayout title={`${siteConfig.brand.primary}${siteConfig.brand.secondary}`}>
  <!-- H2: Hero Section -->
  <Section size="default" surface="base" aria-label="Hero">
    <Stack gap="loose">
      <Grid>
        <Cell placement="full">
          <Stack gap="tight">
            <p class="text-label">{homeData.hero.lead}</p>
            <h1 class="text-display-hero">{homeData.hero.headline.join(' ')}</h1>
            <Cluster gap="tight">
              {homeData.hero.tags.map((tag, idx) => (
                <KeywordTag tagIndex={((idx % 4) + 1) as 1 | 2 | 3 | 4}>{tag.label}</KeywordTag>
              ))}
            </Cluster>
          </Stack>
        </Cell>
        <Cell placement="intro" from="tablet">
          <p class="text-body">{homeData.hero.intro}</p>
        </Cell>
      </Grid>
    </Stack>
  </Section>

  <!-- H3: Statement Section -->
  <Section size="default" surface="base" aria-label="Philosophy">
    <Grid>
      <Cell placement="statement" from="tablet">
        <Stack gap="loose">
          <StatementText
            sentence={homeData.statement.text}
            words={statementWords}
            highlightIndex={statementWords.length}
          />
          <div>
            <Button href={homeData.statement.link.href} variant="outlined" showArrow={true}>
              {homeData.statement.link.label}
            </Button>
          </div>
        </Stack>
      </Cell>
    </Grid>
  </Section>

  <!-- H4: Selected Work -->
  <Section size="default" surface="base" aria-label="Selected Work">
    <Stack gap="section">
      <SectionHeader slashLabel={homeData.work.label} title={homeData.work.heading} />
      <div>
        <Button href="/work" variant="outlined" showArrow={true}>
          {homeData.work.ctaLabel}
        </Button>
      </div>
      <Grid>
        {featuredProjects.map((project, idx) => (
          <Cell placement={idx % 2 === 0 ? 'half-a' : 'half-b'} from="tablet">
            <ProjectCard
              title={project.data.title}
              number={idx + 1}
              description={project.data.summary}
              category={project.data.category}
              year={String(project.data.year)}
              href={`/work/${project.id}`}
              accent={project.data.accent}
              imageSrc={project.data.cover.image}
              imageAlt={project.data.cover.alt}
              variant="grid"
            />
          </Cell>
        ))}
      </Grid>
    </Stack>
  </Section>

  <!-- H5: Capabilities Block -->
  <CapabilitiesBlock />

  <!-- H6: Process Block -->
  <ProcessBlock surface="alt" />

  <!-- H7: Values Block -->
  <ValuesBlock />

  <!-- H8: Numbers Block -->
  <NumbersBlock />

  <!-- H9: Capabilities Marquee -->
  <Section size="compact" surface="base" aria-label="Capabilities Marquee">
    <Bleed>
      <Marquee items={marqueeItems} />
    </Bleed>
  </Section>

  <!-- H10: Contact CTA -->
  <CTABand
    slashLabel={siteConfig.cta.label}
    heading={siteConfig.cta.heading}
    text={siteConfig.cta.text}
    buttonLabel={siteConfig.cta.button.label}
    buttonHref={siteConfig.cta.button.href}
    variant="on-base"
  />
</BaseLayout>
