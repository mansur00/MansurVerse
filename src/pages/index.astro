---
// Home page template (/) per docs/01-design/page-specs.md and docs/01-design/layout-system.md.
// Renders sections H1 to H11 strictly driven by content collections and design tokens.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout-primitives/Section.astro';
import Container from '../components/layout-primitives/Container.astro';
import Grid from '../components/layout-primitives/Grid.astro';
import Cell from '../components/layout-primitives/Cell.astro';
import Stack from '../components/layout-primitives/Stack.astro';
import Bleed from '../components/layout-primitives/Bleed.astro';
import KeywordTag from '../components/primitives/KeywordTag.astro';
import StatementText from '../components/content/StatementText.astro';
import ProjectCard from '../components/content/ProjectCard.astro';
import SectionHeader from '../components/layout/SectionHeader.astro';
import Button from '../components/primitives/Button.astro';
import CapabilitiesBlock from '../components/blocks/CapabilitiesBlock.astro';
import ProcessBlock from '../components/blocks/ProcessBlock.astro';
import ValuesBlock from '../components/blocks/ValuesBlock.astro';
import NumbersBlock from '../components/blocks/NumbersBlock.astro';
import Marquee from '../components/content/Marquee.astro';
import SlashLabel from '../components/primitives/SlashLabel.astro';
import EmailDisplay from '../components/content/EmailDisplay.astro';

import homeData from '../content/home.json';
import profileData from '../content/profile.json';
import capabilitiesData from '../content/capabilities.json';
import { siteConfig } from '../config/site';

// Fetch projects sorted by order (first 4 for Home)
const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

// Prepare marquee items from capabilities with 1-based index numbers
const marqueeItems = capabilitiesData.items.map((item, idx) => ({
  name: item.title,
  number: idx + 1,
}));

// Word tokens for statement scrub animation
const statementWords = homeData.statement.text.split(' ');
---

<BaseLayout
  title={`${siteConfig.brand.primary}${siteConfig.brand.secondary} | Frontend Designer & Developer`}
  description={homeData.hero.intro}
>
  <!-- H2: Hero Section -->
  <Section size="hero" class="hero-section" aria-label="Hero">
    <Container>
      <Grid class="hero-container">
        <Cell placement="full">
          <div class="hero-lead-row">
            <span class="hero-lead text-label">{homeData.hero.lead}</span>
          </div>

          <div class="hero-headline-wrapper">
            <h1 class="hero-title text-display-hero">
              {homeData.hero.headline.map((line, idx) => (
                <span class="hero-line-mask">
                  <span class="hero-line-inner">
                    {line}
                    {idx < homeData.hero.headline.length - 1 && <br />}
                  </span>
                </span>
              ))}
            </h1>

            <div class="hero-tags" aria-hidden="true">
              {homeData.hero.tags.map((tag, idx) => (
                <div class="hero-tag-item" style={`left: ${tag.x}%; top: ${tag.y}%;`}>
                  <KeywordTag tagIndex={((idx % 4) + 1) as 1 | 2 | 3 | 4}>{tag.label}</KeywordTag>
                </div>
              ))}
            </div>
          </div>
        </Cell>

        <Cell placement="intro">
          <div class="hero-intro-row">
            <p class="hero-intro text-body">{homeData.hero.intro}</p>
          </div>
        </Cell>
      </Grid>
    </Container>
  </Section>

  <!-- H3: Statement Section -->
  <Section surface="base" size="default" aria-label="Philosophy">
    <Container>
      <Grid>
        <Cell placement="statement">
          <Stack gap="loose">
            <StatementText
              sentence={homeData.statement.text}
              words={statementWords}
              highlightIndex={statementWords.length}
            />
            <div class="statement-action">
              <Button href={homeData.statement.link.href} variant="outlined" showArrow={true}>
                {homeData.statement.link.label}
              </Button>
            </div>
          </Stack>
        </Cell>
      </Grid>
    </Container>
  </Section>

  <!-- H4: Selected Work -->
  <Section surface="alt" size="default" aria-label="Selected Work">
    <Container>
      <Stack gap="section">
        <SectionHeader slashLabel={homeData.work.label} title={homeData.work.heading} />

        <div class="projects-stack">
          {featuredProjects.map((project, idx) => (
            <ProjectCard
              title={project.data.title}
              number={idx + 1}
              description={project.data.summary}
              category={project.data.category}
              year={String(project.data.year)}
              href={`/work/${project.id}`}
              accent={project.data.accent}
              imageSrc={project.data.cover.image}
              imageAlt={project.data.cover.alt}
              variant="stack"
            />
          ))}
        </div>

        <div class="work-action">
          <Button href="/work" variant="primary" showArrow={true}>
            {homeData.work.ctaLabel}
          </Button>
        </div>
      </Stack>
    </Container>
  </Section>

  <!-- H5: Capabilities -->
  <CapabilitiesBlock />

  <!-- H6: Process -->
  <ProcessBlock surface="alt" />

  <!-- H7: Values -->
  <ValuesBlock />

  <!-- H8: Numbers -->
  <NumbersBlock />

  <!-- H9: Marquee -->
  <Section size="compact" surface="base" aria-hidden="true">
    <Bleed>
      <Marquee items={marqueeItems} />
    </Bleed>
  </Section>

  <!-- H10: Contact CTA -->
  <Section surface="base" size="default" aria-label="Contact">
    <Container>
      <Stack gap="base" class="contact-cta-stack">
        <SlashLabel label={homeData.contactCta.label} variant="on-light" />
        <h2 class="contact-cta-heading text-heading-section">{homeData.contactCta.heading}</h2>
        <div class="email-wrapper">
          <EmailDisplay email={profileData.email} />
        </div>
        <div class="contact-cta-action">
          <Button href={`mailto:${profileData.email}`} variant="primary">
            {siteConfig.form.labels.email}
          </Button>
        </div>
      </Stack>
    </Container>
  </Section>
</BaseLayout>

<style>
  /* H2: Hero */
  .hero-section {
    position: relative;
    isolation: isolate;
    width: 100%;
    overflow: hidden;
  }

  .hero-container {
    position: relative;
    z-index: var(--z-content, 1);
    width: 100%;
  }

  .hero-lead-row {
    position: relative;
    z-index: var(--z-content, 1);
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .hero-lead {
    position: relative;
    z-index: var(--z-content, 1);
    color: var(--color-text-primary);
  }

  .hero-headline-wrapper {
    position: relative;
    z-index: var(--z-content, 1);
    display: inline-block;
    width: 100%;
  }

  .hero-title {
    margin: 0;
    line-height: 0.85;
    color: var(--color-text-primary);
  }

  .hero-line-mask {
    display: block;
    overflow: hidden;
    line-height: 0.85;
  }

  .hero-line-inner {
    display: block;
    will-change: transform;
  }

  .hero-tags {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: var(--z-tag, 2);
  }

  .hero-tag-item {
    position: absolute;
    pointer-events: auto;
    transform-origin: center center;
    z-index: var(--z-tag, 2);
  }

  .hero-intro-row {
    position: relative;
    z-index: var(--z-content, 1);
    margin-top: var(--space-7);
    display: flex;
    justify-content: flex-end;
  }

  .hero-intro {
    max-width: var(--measure-narrow, 34ch);
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (width < 768px) {
    .hero-intro-row {
      justify-content: flex-start;
      margin-top: var(--space-5);
    }

    .hero-tags {
      position: relative;
      inset: auto;
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-top: var(--space-4);
    }

    .hero-tag-item {
      position: static !important;
      transform: none !important;
    }
  }

  /* H3: Statement */
  .statement-action {
    display: flex;
  }

  /* H4: Work */
  .projects-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    width: 100%;
  }

  .work-action {
    display: flex;
  }

  /* H10: Contact CTA */
  .contact-cta-stack {
    max-width: var(--measure-body, 60ch);
  }

  .contact-cta-heading {
    margin: 0;
  }

  .email-wrapper {
    margin-top: var(--space-4);
  }

  .contact-cta-action {
    margin-top: var(--space-4);
    display: flex;
  }
</style>
