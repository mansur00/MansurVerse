---
// Home page (H1 to H11) per docs/01-design/page-specs.md and docs/00-overview/project-brief.md.
// Driven strictly by content collections and design tokens; no hardcoded copy or styles.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/layout/SectionHeader.astro';
import ProjectCard from '../components/content/ProjectCard.astro';
import StatementText from '../components/content/StatementText.astro';
import Marquee from '../components/content/Marquee.astro';
import EmailDisplay from '../components/content/EmailDisplay.astro';
import KeywordTag from '../components/primitives/KeywordTag.astro';
import Button from '../components/primitives/Button.astro';
import SlashLabel from '../components/primitives/SlashLabel.astro';
import CapabilitiesBlock from '../components/blocks/CapabilitiesBlock.astro';
import ProcessBlock from '../components/blocks/ProcessBlock.astro';
import ValuesBlock from '../components/blocks/ValuesBlock.astro';
import NumbersBlock from '../components/blocks/NumbersBlock.astro';
import homeData from '../content/home.json';
import profileData from '../content/profile.json';
import capabilitiesData from '../content/capabilities.json';
import { siteConfig } from '../config/site';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const marqueeItems = capabilitiesData.items.map((item, idx) => ({
  name: item.title,
  number: idx + 1,
}));

const statementWords = homeData.statement.text.split(' ');
---

<BaseLayout title={`${siteConfig.brand.primary}${siteConfig.brand.secondary}`}>
  <!-- H2: Hero Section -->
  <section class="hero-section" aria-label="Hero">
    <canvas id="digit-field-canvas" class="digit-field-canvas" aria-hidden="true"></canvas>
    <noscript>
      <style>
        .digit-field-canvas {
          background-image: url('/assets/digit-field-poster.svg');
          background-size: 560px 560px;
          background-repeat: repeat;
        }
      </style>
    </noscript>
    <div class="hero-container">
      <div class="hero-lead-row">
        <p class="hero-lead text-label">{homeData.hero.lead}</p>
      </div>

      <div class="hero-headline-wrapper">
        <h1 class="hero-title text-display-hero" aria-label={homeData.hero.headline.join(' ')}>
          {homeData.hero.headline.map((line) => (
            <span class="hero-line-mask" aria-hidden="true">
              <span class="hero-line-inner">{line}</span>
            </span>
          ))}
        </h1>

        <div class="hero-tags" aria-hidden="true">
          {homeData.hero.tags.map((tag, idx) => (
            <div class="hero-tag-item" style={`left: ${tag.x}%; top: ${tag.y}%;`}>
              <KeywordTag tagIndex={((idx % 4) + 1) as 1 | 2 | 3 | 4}>{tag.label}</KeywordTag>
            </div>
          ))}
        </div>
      </div>

      <div class="hero-intro-row">
        <p class="hero-intro text-body">{homeData.hero.intro}</p>
      </div>
    </div>
  </section>

  <!-- H3: Statement Section -->
  <section class="statement-section" aria-label="Philosophy">
    <div class="statement-container">
      <StatementText
        sentence={homeData.statement.text}
        words={statementWords}
        highlightIndex={statementWords.length}
      />
      <div class="statement-action">
        <Button href={homeData.statement.link.href} variant="outlined" showArrow={true}>
          {homeData.statement.link.label}
        </Button>
      </div>
    </div>
  </section>

  <!-- H4: Selected Work -->
  <section class="work-section" aria-label="Selected Work">
    <div class="work-container">
      <div class="work-header">
        <SectionHeader slashLabel={homeData.work.label} title={homeData.work.heading} />
      </div>

      <div class="projects-stack">
        {featuredProjects.map((project, idx) => (
          <ProjectCard
            title={project.data.title}
            number={idx + 1}
            description={project.data.summary}
            category={project.data.category}
            year={String(project.data.year)}
            href={`/work/${project.id}`}
            accent={project.data.accent}
            imageSrc={project.data.cover.image}
            imageAlt={project.data.cover.alt}
            variant="stack"
          />
        ))}
      </div>

      <div class="work-action">
        <Button href="/work" variant="primary" showArrow={true}>
          {homeData.work.ctaLabel}
        </Button>
      </div>
    </div>
  </section>

  <!-- H5: Capabilities -->
  <CapabilitiesBlock />

  <!-- H6: Process -->
  <ProcessBlock surface="alt" />

  <!-- H7: Values -->
  <ValuesBlock />

  <!-- H8: Numbers -->
  <NumbersBlock />

  <!-- H9: Marquee -->
  <section class="marquee-section" aria-hidden="true">
    <Marquee items={marqueeItems} />
  </section>

  <!-- H10: Contact CTA -->
  <section class="contact-cta-section" aria-label="Contact">
    <div class="contact-cta-container">
      <SlashLabel label={homeData.contactCta.label} variant="on-light" />
      <h2 class="contact-cta-heading text-heading-section">{homeData.contactCta.heading}</h2>
      <div class="email-wrapper">
        <EmailDisplay email={profileData.email} />
      </div>
      <div class="contact-cta-action">
        <Button href={`mailto:${profileData.email}`} variant="primary">
          {siteConfig.form.labels.email}
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* H2: Hero */
  .hero-section {
    position: relative;
    isolation: isolate;
    min-height: 85vh;
    padding: var(--space-12) var(--layout-page-gutter);
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  .digit-field-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: var(--opacity-digit-field, 0.45);
    color: var(--color-digit-field);
    z-index: 0;
  }

  .digit-field-canvas.no-webgl {
    background-image: url('/assets/digit-field-poster.svg');
    background-size: 560px 560px;
    background-repeat: repeat;
  }

  .hero-container {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    position: relative;
    z-index: var(--z-content, 1);
  }

  .hero-lead-row {
    position: relative;
    z-index: var(--z-content, 1);
    color: var(--color-text-primary);
  }

  .hero-lead {
    position: relative;
    z-index: var(--z-content, 1);
    color: var(--color-text-primary);
  }

  .hero-headline-wrapper {
    position: relative;
    z-index: var(--z-content, 1);
    display: inline-block;
    width: 100%;
  }

  .hero-title {
    margin: 0;
    line-height: 0.85;
    color: var(--color-text-primary);
  }

  .hero-line-mask {
    display: block;
    overflow: hidden;
    line-height: 0.85;
  }

  .hero-line-inner {
    display: block;
    will-change: transform;
  }

  .hero-tags {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-tag-item {
    position: absolute;
    pointer-events: auto;
    transform-origin: center center;
    z-index: var(--z-tag, 2);
  }

  .hero-intro-row {
    position: relative;
    z-index: var(--z-content, 1);
    margin-left: auto;
    max-width: 36ch;
    color: var(--color-text-muted);
  }

  @media (width < 768px) {
    .hero-intro-row {
      margin-left: 0;
    }
  }

  /* H3: Statement */
  .statement-section {
    padding: var(--space-12) var(--layout-page-gutter);
    background: var(--color-bg-base);
  }

  .statement-container {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .statement-action {
    display: flex;
  }

  /* H4: Work */
  .work-section {
    padding: var(--space-12) var(--layout-page-gutter);
    background: var(--color-bg-alt);
  }

  .work-container {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .projects-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .work-action {
    margin-top: var(--space-4);
    display: flex;
  }

  /* H9: Marquee */
  .marquee-section {
    padding: var(--space-8) 0;
    background: var(--color-bg-base);
    overflow: hidden;
  }

  /* H10: Contact CTA */
  .contact-cta-section {
    padding: var(--space-12) var(--layout-page-gutter);
    background: var(--color-bg-alt);
  }

  .contact-cta-container {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .contact-cta-heading {
    margin: 0;
  }

  .email-wrapper {
    margin: var(--space-4) 0;
  }

  .contact-cta-action {
    display: flex;
  }
</style>

<script>
  import { isFeatureDisabled } from '../scripts/debug/features';

  let digitFieldCleanup: (() => void) | null = null;

  function setupHeroDigitField(): void {
    const canvas = document.getElementById('digit-field-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    if (isFeatureDisabled('digitfield')) {
      canvas.classList.add('no-webgl');
      canvas.setAttribute('data-webgl-ready', 'false');
      return;
    }

    const loadWebGL = () => {
      import('../scripts/webgl/digit-field')
        .then((m) => m.initDigitField(canvas))
        .then((cleanup) => {
          digitFieldCleanup = cleanup;
          canvas.setAttribute('data-webgl-ready', 'true');
        })
        .catch((err) => {
          console.error('Failed to load WebGL digit field:', err);
          canvas.classList.add('no-webgl');
          canvas.setAttribute('data-webgl-ready', 'false');
        });
    };

    if (typeof window !== 'undefined') {
      const win = window as Window & {
        requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => number;
      };
      if (typeof win.requestIdleCallback === 'function') {
        win.requestIdleCallback(loadWebGL, { timeout: 800 });
      } else {
        setTimeout(loadWebGL, 1);
      }
    }
  }

  if (typeof window !== 'undefined') {
    document.addEventListener('astro:page-load', setupHeroDigitField);
    document.addEventListener('astro:before-swap', () => {
      if (digitFieldCleanup) {
        digitFieldCleanup();
        digitFieldCleanup = null;
      }
    });
  }
</script>
