---
// Contact page template (/contact) per docs/01-design/page-specs.md and docs/01-design/layout-system.md.
// Renders sections K1 to K4: form with blur validation, availability card, social links, and shared blocks.
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout-primitives/Section.astro';
import Container from '../components/layout-primitives/Container.astro';
import Grid from '../components/layout-primitives/Grid.astro';
import Cell from '../components/layout-primitives/Cell.astro';
import Stack from '../components/layout-primitives/Stack.astro';
import SlashLabel from '../components/primitives/SlashLabel.astro';
import Form from '../components/forms/Form.astro';
import Button from '../components/primitives/Button.astro';
import ProcessBlock from '../components/blocks/ProcessBlock.astro';
import OpenToBlock from '../components/blocks/OpenToBlock.astro';

import profileData from '../content/profile.json';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title={`Contact | ${siteConfig.brand.primary}${siteConfig.brand.secondary}`}
  description="Start a project, inquire about availability, or connect for contract and full-time opportunities."
>
  <!-- K1: Header & K2: Form and Info -->
  <Section surface="base" size="default" class="contact-hero-section" aria-label="Contact">
    <Container>
      <Grid>
        <Cell placement="half-a" from="desktop">
          <Stack gap="loose" class="contact-main-col">
            <SlashLabel label="Get in touch" variant="on-light" />
            <h1 class="contact-title text-display-page">Let’s work together.</h1>
            <div class="contact-form-wrapper">
              <Form data-fallback-email={profileData.email} />
            </div>
          </Stack>
        </Cell>

        <Cell placement="half-b" from="desktop">
          <Stack gap="loose" class="contact-info-col">
            <div class="availability-card">
              <div class="status-indicator">
                <span class="status-dot" aria-hidden="true"></span>
                <span class="status-text text-label">{profileData.availability.label}</span>
              </div>

              <p class="availability-desc text-body">
                Available for remote contracts, design systems, and frontend architecture.
              </p>

              <div class="direct-email-row">
                <Button
                  href={`mailto:${profileData.email}`}
                  variant="primary"
                  data-copy={profileData.email}
                  data-motion="copy-clipboard"
                >
                  {profileData.email}
                </Button>
              </div>
            </div>

            <div class="social-links-block">
              <span class="social-heading text-label">Elsewhere</span>
              <div class="social-links-list">
                {profileData.socials.map((social) => (
                  <a
                    href={social.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="social-link text-body"
                  >
                    {social.label} ↗
                  </a>
                ))}
              </div>
            </div>
          </Stack>
        </Cell>
      </Grid>
    </Container>
  </Section>

  <!-- K3: Process Block -->
  <ProcessBlock surface="alt" />

  <!-- K4: Open To Block -->
  <OpenToBlock surface="base" />
</BaseLayout>

<style>
  .contact-main-col {
    width: 100%;
  }

  .contact-title {
    margin: 0;
  }

  .contact-form-wrapper {
    margin-top: var(--space-4);
    width: 100%;
  }

  .contact-info-col {
    width: 100%;
  }

  .availability-card {
    background: var(--color-bg-surface);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
    box-sizing: border-box;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-circle);
    background: var(--color-accent-primary);
  }

  .status-text {
    color: var(--color-text-primary);
  }

  .availability-desc {
    margin: 0;
    color: var(--color-text-muted);
  }

  .direct-email-row {
    margin-top: var(--space-2);
  }

  .social-links-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
  }

  .social-heading {
    color: var(--color-text-muted);
  }

  .social-links-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .social-link {
    text-decoration: none;
    color: var(--color-text-primary);
    transition: color var(--motion-fast) var(--ease-out);
  }

  .social-link:hover {
    color: var(--color-accent-primary);
  }
</style>

<script>
  const init = async () => {
    const { initContactPage } = await import('../scripts/motion/contact');
    initContactPage();
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
  document.addEventListener('astro:page-load', init);
</script>
