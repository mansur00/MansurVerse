---
// Internal style guide & design system catalog.
// Composes the 6 section components from src/components/styleguide/.
// Generated from token source and fixtures; no hardcoded copy or magic numbers.
// Not indexed; removed from production builds unless PUBLIC_ENABLE_STYLEGUIDE=true.
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/primitives/Logo.astro';
import Chip from '../components/primitives/Chip.astro';
import SlashLabel from '../components/primitives/SlashLabel.astro';
import ThemeToggle from '../components/layout/ThemeToggle.astro';
import MotionToggle from '../components/layout/MotionToggle.astro';
import Footer from '../components/layout/Footer.astro';
import ColourSection from '../components/styleguide/ColourSection.astro';
import TypographySection from '../components/styleguide/TypographySection.astro';
import ShapesSection from '../components/styleguide/ShapesSection.astro';
import ComponentsSection from '../components/styleguide/ComponentsSection.astro';
import MotionSection from '../components/styleguide/MotionSection.astro';
import CompositionSection from '../components/styleguide/CompositionSection.astro';
import LayoutSection from '../components/styleguide/LayoutSection.astro';
import { styleguideFixtures } from '../fixtures/styleguide';

const f = styleguideFixtures;
---

<BaseLayout title={f.pageTitle} noindex nav={false} footer={false}>
  <div class="sg-root">
    <!-- Header -->
    <header class="sg-header">
      <div class="sg-header-top">
        <div class="sg-header-brand">
          <Logo />
          <Chip variant="accent">{f.badge}</Chip>
        </div>
        <div class="sg-header-controls">
          <ThemeToggle />
          <MotionToggle />
        </div>
      </div>

      <div class="sg-header-hero">
        <SlashLabel label={f.sections.colour.label} />
        <h1 class="text-display-page sg-title">{f.header.title}</h1>
        <p class="text-body sg-intro">{f.header.intro}</p>
      </div>

      <nav class="sg-sticky-nav" aria-label={f.header.title}>
        <ul class="sg-nav-list">
          {f.header.navLinks.map((link) => (
            <li>
              <a href={link.href} class="sg-nav-link text-label">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main">
      <ColourSection />
      <TypographySection />
      <ShapesSection />
      <ComponentsSection />
      <MotionSection />
      <CompositionSection />
      <LayoutSection />
    </main>

    <!-- Footer -->
    <Footer
      pages={f.layout.footer.pages}
      socials={f.layout.footer.socials}
      localTimeLabel={f.layout.footer.localTimeLabel}
      timeZone={f.layout.footer.timeZone}
      copyright={f.layout.footer.copyright}
    />
  </div>
</BaseLayout>

<style>
  .sg-root {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--color-bg-base);
    color: var(--color-text-primary);
  }

  .sg-header {
    width: 100%;
    background: var(--color-bg-base);
    padding: var(--space-6) var(--layout-pad) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .sg-header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .sg-header-brand {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .sg-header-controls {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .sg-header-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .sg-title {
    color: var(--color-text-primary);
    margin: 0;
  }

  .sg-intro {
    max-width: 65ch;
    color: var(--color-text-muted);
    margin: 0;
  }

  .sg-sticky-nav {
    position: sticky;
    top: 0;
    background: var(--color-bg-base);
    padding: var(--space-3) 0;
    z-index: var(--z-header);
    overflow-x: auto;
  }

  .sg-nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    white-space: nowrap;
  }

  .sg-nav-link {
    text-decoration: none;
    color: var(--color-text-muted);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-pill);
    transition: color var(--motion-fast) var(--ease-out);
  }

  .sg-nav-link:hover {
    color: var(--color-text-primary);
    background: var(--color-bg-alt);
  }
</style>
