---
// Internal style guide & design system catalog.
// Generated from token source and fixtures; no hardcoded copy or magic numbers.
// Not indexed; removed from production builds unless PUBLIC_ENABLE_STYLEGUIDE=true.
import BaseLayout from '../layouts/BaseLayout.astro';
import summary from '../styles/tokens/generated/tokens.summary.json';
import Logo from '../components/primitives/Logo.astro';
import Button from '../components/primitives/Button.astro';
import Chip from '../components/primitives/Chip.astro';
import KeywordTag from '../components/primitives/KeywordTag.astro';
import SlashLabel from '../components/primitives/SlashLabel.astro';
import SuperscriptNumber from '../components/primitives/SuperscriptNumber.astro';
import PixelShape from '../components/primitives/PixelShape.astro';
import Divider from '../components/primitives/Divider.astro';
import Nav from '../components/layout/Nav.astro';
import ThemeToggle from '../components/layout/ThemeToggle.astro';
import MotionToggle from '../components/layout/MotionToggle.astro';
import SectionHeader from '../components/layout/SectionHeader.astro';
import CTABand from '../components/layout/CTABand.astro';
import Footer from '../components/layout/Footer.astro';
import MenuOverlay from '../components/layout/MenuOverlay.astro';
import ProjectCard from '../components/content/ProjectCard.astro';
import CapabilityRow from '../components/content/CapabilityRow.astro';
import ProcessStep from '../components/content/ProcessStep.astro';
import ValueRow from '../components/content/ValueRow.astro';
import StatTile from '../components/content/StatTile.astro';
import JobRow from '../components/content/JobRow.astro';
import Marquee from '../components/content/Marquee.astro';
import StatementText from '../components/content/StatementText.astro';
import EmailDisplay from '../components/content/EmailDisplay.astro';
import ExperienceRow from '../components/content/ExperienceRow.astro';
import SkillChips from '../components/content/SkillChips.astro';
import MetaSidebar from '../components/content/MetaSidebar.astro';
import FormField from '../components/forms/FormField.astro';
import Form from '../components/forms/Form.astro';
import { styleguideFixtures } from '../fixtures/styleguide';

const f = styleguideFixtures;
const colors = summary.colors;
const palette = Object.entries(summary.palette);
const roles = summary.roles;
const contrast = summary.contrast;
const space = Object.entries(summary.space);
const radius = Object.entries(summary.radius);
const motion = Object.entries(summary.motion);
const z = Object.entries(summary.z);
const opacity = Object.entries(summary.opacity);
---

<BaseLayout title={f.pageTitle} noindex>
  <div class="sg-root">
    <!-- Header -->
    <header class="sg-header">
      <div class="sg-header-top">
        <div class="sg-header-brand">
          <Logo />
          <Chip variant="accent">{f.badge}</Chip>
        </div>
        <div class="sg-header-controls">
          <ThemeToggle />
          <MotionToggle />
        </div>
      </div>

      <div class="sg-header-hero">
        <SlashLabel label={f.sections.colour.label} />
        <h1 class="text-display-page sg-title">{f.header.title}</h1>
        <p class="text-body sg-intro">{f.header.intro}</p>
      </div>

      <nav class="sg-sticky-nav" aria-label={f.header.title}>
        <ul class="sg-nav-list">
          {f.header.navLinks.map((link) => (
            <li>
              <a href={link.href} class="sg-nav-link text-label">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main">
      <!-- 01 COLOUR -->
      <section id="colour" class="sg-section sg-surface-base">
        <div class="sg-section-content">
          <div class="sg-section-header">
            <SlashLabel label={f.sections.colour.label} />
            <h2 class="text-heading-section sg-section-title">
              {f.sections.colour.title}
              <SuperscriptNumber number={f.sections.colour.number} />
            </h2>
          </div>

          <!-- Core Palette -->
          <div class="sg-block">
            <h3 class="text-heading-case sg-block-title">{f.sections.colour.paletteTitle}</h3>
            <p class="text-body-small sg-block-desc">{f.sections.colour.paletteDesc}</p>
            <div class="palette-grid">
              {palette.map(([name, value]) => (
                <div class="palette-card">
                  <div class="palette-swatch" style={`background: var(--palette-${name})`} />
                  <div class="palette-meta">
                    <span class="text-label palette-name">{name}</span>
                    <span class="text-body-small palette-hex">{value}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <Divider variant="on-base" />

          <!-- Semantic Tokens -->
          <div class="sg-block">
            <h3 class="text-heading-case sg-block-title">{f.sections.colour.semanticTitle}</h3>
            <p class="text-body-small sg-block-desc">{f.sections.colour.semanticDesc}</p>
            <div class="semantic-grid">
              {colors.map((c) => (
                <div class="semantic-card">
                  <div class="semantic-swatches">
                    <div class="semantic-swatch" style={`background: ${c.light}`}>
                      <span class="text-body-small swatch-tag">{f.sections.colour.lightLabel}</span>
                    </div>
                    <div class="semantic-swatch" style={`background: ${c.dark}`}>
                      <span class="text-body-small swatch-tag swatch-tag-dark">
                        {f.sections.colour.darkLabel}
                      </span>
                    </div>
                  </div>
                  <div class="semantic-meta">
                    <span class="text-label semantic-name">{c.name}</span>
                    <span class="text-body-small semantic-vals">
                      {c.light} / {c.dark}
                    </span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <Divider variant="on-base" />

          <!-- Contrast Pairs -->
          <div class="sg-block">
            <h3 class="text-heading-case sg-block-title">{f.sections.colour.contrastTitle}</h3>
            <p class="text-body-small sg-block-desc">{f.sections.colour.contrastDesc}</p>
            <div class="contrast-grid">
              {contrast.map((item) => (
                <div
                  class="contrast-card"
                  style={`background: ${item.bgValue}; color: ${item.fgValue}`}
                >
                  <div class="contrast-top">
                    <span class="text-label contrast-pair-label">
                      {item.fg} / {item.bg}
                    </span>
                    <Chip variant="accent">
                      {item.pass ? f.sections.colour.statusPass : f.sections.colour.statusFail}
                    </Chip>
                  </div>
                  <div class="contrast-bottom">
                    <div class="contrast-ratio-row">
                      <span class="text-heading-job">{item.ratio}:1</span>
                      <span class="text-body-small contrast-target">
                        {f.sections.colour.thresholdLabel}: {item.min}:1
                      </span>
                    </div>
                    <span class="text-body-small contrast-theme-pill">{item.theme}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- 02 TYPOGRAPHY -->
      <section id="typography" class="sg-section sg-surface-alt">
        <div class="sg-section-content">
          <div class="sg-section-header">
            <SlashLabel label={f.sections.typography.label} />
            <h2 class="text-heading-section sg-section-title">
              {f.sections.typography.title}
              <SuperscriptNumber number={f.sections.typography.number} />
            </h2>
            <p class="text-body sg-section-intro">{f.sections.typography.intro}</p>
          </div>

          <!-- Font Specimens -->
          <div class="sg-block">
            <div class="specimens-stack">
              {f.sections.typography.specimens.map((spec) => (
                <div class="specimen-card">
                  <div class="specimen-meta">
                    <h3 class="text-heading-case specimen-family">{spec.family}</h3>
                    <Chip variant="outlined">{spec.role}</Chip>
                  </div>
                  {spec.isDisplay ? (
                    <h1 class="text-display-page specimen-sample">{spec.sample}</h1>
                  ) : (
                    <p class="text-heading-row specimen-sample">{spec.sample}</p>
                  )}
                </div>
              ))}
            </div>
          </div>

          <Divider variant="on-base" />

          <!-- Rendered Text Roles -->
          <div class="sg-block">
            <h3 class="text-heading-case sg-block-title">{f.sections.typography.rolesTitle}</h3>
            <p class="text-body-small sg-block-desc">{f.sections.typography.rolesDesc}</p>
            <div class="roles-list">
              {roles.map((r) => (
                <div class="role-row">
                  <div class="role-meta">
                    <div class="role-title-row">
                      <span class="text-heading-job role-name">{r.name}</span>
                      <Chip variant="filled">{r.element}</Chip>
                    </div>
                    <p class="text-body-small role-specs">
                      {r.font} · {r.size} · weight {r.weight} · line {r.line}
                    </p>
                  </div>
                  <div class="role-preview">
                    <div class={`text-${r.name} role-sample-text`}>
                      {f.sections.typography.sampleText}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- 03 SHAPES & SPACING -->
      <section id="shapes" class="sg-section sg-surface-base">
        <div class="sg-section-content">
          <div class="sg-section-header">
            <SlashLabel label={f.sections.shapes.label} />
            <h2 class="text-heading-section sg-section-title">
              {f.sections.shapes.title}
              <SuperscriptNumber number={f.sections.shapes.number} />
            </h2>
          </div>

          <!-- Pixel Shapes -->
          <div class="sg-block">
            <h3 class="text-heading-case sg-block-title">{f.sections.shapes.pixelShapesTitle}</h3>
            <p class="text-body-small sg-block-desc">{f.sections.shapes.pixelShapesDesc}</p>
            <div class="shapes-row">
              {f.primitives.pixelShapes.map((shape) => (
                <div class="shape-item">
                  <PixelShape variant={shape.variant} accent={shape.accent} />
                  <span class="text-body-small shape-label">
                    {shape.variant} / {shape.accent}
                  </span>
                </div>
              ))}
            </div>
          </div>

          <Divider variant="on-base" />

          <!-- Half-Pill -->
          <div class="sg-block">
            <h3 class="text-heading-case sg-block-title">{f.sections.shapes.halfPillTitle}</h3>
            <p class="text-body-small sg-block-desc">{f.sections.shapes.halfPillDesc}</p>
            <div class="half-pill-demo">
              <div class="half-pill-shape">
                <span class="text-label half-pill-text">{f.sections.shapes.halfPillLabel}</span>
              </div>
            </div>
          </div>

          <Divider variant="on-base" />

          <!-- Radii & Spacing Grid -->
          <div class="sg-grid-2">
            <div class="sg-block">
              <h3 class="text-heading-case sg-block-title">{f.sections.shapes.radiusTitle}</h3>
              <div class="radius-list">
                {radius.map(([name, val]) => (
                  <div class="scale-item">
                    <span class="text-label scale-name">--radius-{name}</span>
                    <span class="text-body-small scale-val">{val}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="sg-block">
              <h3 class="text-heading-case sg-block-title">{f.sections.shapes.spaceTitle}</h3>
              <div class="space-list">
                {space.map(([name, val]) => (
                  <div class="space-bar-row">
                    <span class="text-label space-name">{name}</span>
                    <div class="space-bar-wrap">
                      <div class="space-bar" style={`width: var(--space-${name})`} />
                    </div>
                    <span class="text-body-small space-val">{val}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <Divider variant="on-base" />

          <!-- Z-Index & Opacity -->
          <div class="sg-grid-2">
            <div class="sg-block">
              <h3 class="text-heading-case sg-block-title">{f.sections.shapes.zIndexTitle}</h3>
              <div class="scale-list">
                {z.map(([name, val]) => (
                  <div class="scale-item">
                    <span class="text-label scale-name">--z-{name}</span>
                    <span class="text-body-small scale-val">{val}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="sg-block">
              <h3 class="text-heading-case sg-block-title">{f.sections.shapes.opacityTitle}</h3>
              <div class="scale-list">
                {opacity.map(([name, val]) => (
                  <div class="scale-item">
                    <span class="text-label scale-name">--opacity-{name}</span>
                    <span class="text-body-small scale-val">{val}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 04 COMPONENTS -->
      <section id="components" class="sg-section sg-surface-alt">
        <div class="sg-section-content">
          <div class="sg-section-header">
            <SlashLabel label={f.sections.components.label} />
            <h2 class="text-heading-section sg-section-title">
              {f.sections.components.title}
              <SuperscriptNumber number={f.sections.components.number} />
            </h2>
            <p class="text-body sg-section-intro">{f.sections.components.intro}</p>
          </div>

          <!-- Group 1: Primitives -->
          <div class="sg-block">
            <h3 class="text-heading-case sg-block-title">
              {f.sections.components.groups.primitives.title}
            </h3>
            <p class="text-body-small sg-block-desc">
              {f.sections.components.groups.primitives.desc}
            </p>

            <div class="component-showcase-box">
              <h4 class="text-heading-job showcase-subtitle">
                {f.sections.components.stateLabels.buttons}
              </h4>
              <div class="showcase-row">
                {f.primitives.buttons.map((btn) => (
                  <Button
                    variant={btn.variant}
                    showArrow={btn.showArrow}
                    disabled={btn.disabled}
                    loading={btn.loading}
                    success={btn.success}
                  >
                    {btn.label}
                  </Button>
                ))}
              </div>

              <h4 class="text-heading-job showcase-subtitle">
                {f.sections.components.stateLabels.chips}
              </h4>
              <div class="showcase-row">
                {f.primitives.chips.map((c) => (
                  <Chip variant={c.variant} active={c.active}>
                    {c.label}
                  </Chip>
                ))}
              </div>

              <h4 class="text-heading-job showcase-subtitle">
                {f.sections.components.stateLabels.tags}
              </h4>
              <div class="showcase-row">
                {f.primitives.tags.map((t) => (
                  <KeywordTag tagIndex={t.tagIndex}>{t.text}</KeywordTag>
                ))}
              </div>

              <h4 class="text-heading-job showcase-subtitle">
                {f.sections.components.stateLabels.slashLabels}
              </h4>
              <div class="showcase-row">
                {f.primitives.slashLabels.map((s) => (
                  <SlashLabel label={s.label} variant={s.variant} />
                ))}
              </div>

              <h4 class="text-heading-job showcase-subtitle">
                {f.sections.components.stateLabels.superscripts}
              </h4>
              <div class="showcase-row">
                {f.primitives.numbers.map((n) => (
                  <span class="text-heading-case">
                    Item
                    <SuperscriptNumber number={n} />
                  </span>
                ))}
              </div>
            </div>
          </div>

          <Divider variant="on-base" />

          <!-- Group 2: Layout -->
          <div class="sg-block">
            <h3 class="text-heading-case sg-block-title">
              {f.sections.components.groups.layout.title}
            </h3>
            <p class="text-body-small sg-block-desc">{f.sections.components.groups.layout.desc}</p>

            <div class="component-showcase-box">
              <Nav navLinks={f.layout.navLinks} />
              <MenuOverlay links={f.layout.navLinks} isOpen={false} />
              <SectionHeader
                slashLabel={f.layout.sectionHeader.slashLabel}
                title={f.layout.sectionHeader.title}
              />
              <CTABand
                slashLabel={f.layout.cta.slashLabel}
                heading={f.layout.cta.heading}
                text={f.layout.cta.text}
                buttonLabel={f.layout.cta.buttonLabel}
                buttonHref={f.layout.cta.buttonHref}
                variant="on-alt"
              />
            </div>
          </div>

          <Divider variant="on-base" />

          <!-- Group 3: Content -->
          <div class="sg-block">
            <h3 class="text-heading-case sg-block-title">
              {f.sections.components.groups.content.title}
            </h3>
            <p class="text-body-small sg-block-desc">{f.sections.components.groups.content.desc}</p>

            <!-- Project Cards -->
            <h4 class="text-heading-job showcase-subtitle">
              {f.sections.components.stateLabels.cards}
            </h4>
            <div class="projects-stack">
              {f.content.projects.map((proj) => (
                <ProjectCard
                  title={proj.title}
                  number={proj.number}
                  description={proj.description}
                  category={proj.category}
                  year={proj.year}
                  href={proj.href}
                  accent={proj.accent}
                  imageAlt={proj.imageAlt}
                />
              ))}
            </div>

            <!-- Capabilities -->
            <div class="content-demos-stack">
              {f.content.capabilities.map((cap) => (
                <CapabilityRow
                  title={cap.title}
                  number={cap.number}
                  description={cap.description}
                  tags={cap.tags}
                />
              ))}
            </div>

            <!-- Process Steps -->
            <div class="process-grid">
              {f.content.processSteps.map((step) => (
                <ProcessStep stepNumber={step.stepNumber} title={step.title} text={step.text} />
              ))}
            </div>

            <!-- Values -->
            <div class="content-demos-stack">
              {f.content.values.map((v) => (
                <ValueRow slashLabel={v.slashLabel} text={v.text} />
              ))}
            </div>

            <!-- Stats -->
            <div class="stats-grid">
              {f.content.stats.map((s) => (
                <StatTile
                  number={s.number}
                  caption={s.caption}
                  variant={s.variant}
                  staggered={s.staggered}
                />
              ))}
            </div>

            <!-- Marquee -->
            <div class="marquee-demo">
              <Marquee items={f.content.marqueeItems} />
            </div>

            <!-- Statement Text -->
            <div class="statement-demo">
              <StatementText
                sentence={f.content.statement.sentence}
                words={f.content.statement.words}
              />
            </div>

            <!-- Email Display -->
            <div class="email-demo">
              <EmailDisplay email={f.content.email} />
            </div>

            <!-- Experience Rows -->
            <div class="content-demos-stack">
              {f.content.experience.map((exp) => (
                <ExperienceRow
                  period={exp.period}
                  role={exp.role}
                  company={exp.company}
                  location={exp.location}
                />
              ))}
            </div>

            <!-- Job Rows -->
            <div class="content-demos-stack">
              {f.content.jobs.map((job) => (
                <JobRow
                  category={job.category}
                  title={job.title}
                  meta={job.meta}
                  ctaLabel={job.ctaLabel}
                  ctaHref={job.ctaHref}
                />
              ))}
            </div>

            <!-- Meta Sidebar -->
            <div class="meta-sidebar-demo">
              <MetaSidebar
                role={f.content.metaSidebar.role}
                year={f.content.metaSidebar.year}
                tools={f.content.metaSidebar.tools}
                links={f.content.metaSidebar.links}
                sections={f.content.metaSidebar.sections}
              />
            </div>

            <!-- Skill Chips -->
            <div class="chips-demo">
              <SkillChips skills={f.content.skills} />
            </div>
          </div>

          <Divider variant="on-base" />

          <!-- Group 4: Forms -->
          <div class="sg-block">
            <h3 class="text-heading-case sg-block-title">
              {f.sections.components.groups.forms.title}
            </h3>
            <p class="text-body-small sg-block-desc">{f.sections.components.groups.forms.desc}</p>

            <div class="forms-demos-grid">
              <div class="form-demo-col">
                <h4 class="text-heading-job showcase-subtitle">
                  {f.sections.components.stateLabels.formIdle}
                </h4>
                <FormField
                  name={f.content.forms.fields.idle.name}
                  label={f.content.forms.fields.idle.label}
                />
                <FormField
                  name={f.content.forms.fields.focus.name}
                  label={f.content.forms.fields.focus.label}
                  state={f.content.forms.fields.focus.state}
                  value={f.content.forms.fields.focus.value}
                />
                <FormField
                  name={f.content.forms.fields.filled.name}
                  label={f.content.forms.fields.filled.label}
                  state={f.content.forms.fields.filled.state}
                  value={f.content.forms.fields.filled.value}
                />
              </div>

              <div class="form-demo-col">
                <h4 class="text-heading-job showcase-subtitle">
                  {f.sections.components.stateLabels.formFailed}
                </h4>
                <FormField
                  name={f.content.forms.fields.error.name}
                  label={f.content.forms.fields.error.label}
                  state={f.content.forms.fields.error.state}
                  value={f.content.forms.fields.error.value}
                  errorMessage={f.content.forms.fields.error.errorMessage}
                />
                <FormField
                  name={f.content.forms.fields.disabled.name}
                  label={f.content.forms.fields.disabled.label}
                  state={f.content.forms.fields.disabled.state}
                  value={f.content.forms.fields.disabled.value}
                  disabled={f.content.forms.fields.disabled.disabled}
                />
                <FormField
                  name={f.content.forms.fields.textarea.name}
                  label={f.content.forms.fields.textarea.label}
                  as={f.content.forms.fields.textarea.as}
                  rows={f.content.forms.fields.textarea.rows}
                />
              </div>
            </div>

            <!-- Complete Form Lifecycle States -->
            <div class="form-lifecycle-stack">
              <div class="form-box">
                <h4 class="text-heading-job showcase-subtitle">
                  {f.sections.components.stateLabels.formSending}
                </h4>
                <Form
                  state={f.content.forms.formStates.sending.state}
                  nameValue={f.content.forms.formStates.sending.nameValue}
                  emailValue={f.content.forms.formStates.sending.emailValue}
                  messageValue={f.content.forms.formStates.sending.messageValue}
                />
              </div>

              <div class="form-box">
                <h4 class="text-heading-job showcase-subtitle">
                  {f.sections.components.stateLabels.formSent}
                </h4>
                <Form
                  state={f.content.forms.formStates.sent.state}
                  nameValue={f.content.forms.formStates.sent.nameValue}
                  emailValue={f.content.forms.formStates.sent.emailValue}
                  messageValue={f.content.forms.formStates.sent.messageValue}
                />
              </div>

              <div class="form-box">
                <h4 class="text-heading-job showcase-subtitle">
                  {f.sections.components.stateLabels.formFailed}
                </h4>
                <Form
                  state={f.content.forms.formStates.failed.state}
                  nameValue={f.content.forms.formStates.failed.nameValue}
                  emailValue={f.content.forms.formStates.failed.emailValue}
                  messageValue={f.content.forms.formStates.failed.messageValue}
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 05 MOTION -->
      <section id="motion" class="sg-section sg-surface-feature">
        <div class="sg-section-content">
          <div class="sg-section-header">
            <SlashLabel label={f.sections.motion.label} variant="on-feature" />
            <h2 class="text-heading-section feature-title">
              {f.sections.motion.title}
              <SuperscriptNumber number={f.sections.motion.number} />
            </h2>
            <p class="text-body feature-intro">{f.sections.motion.intro}</p>
          </div>

          <!-- Durations & Easing Curves -->
          <div class="sg-grid-2">
            <div class="sg-block">
              <h3 class="text-heading-case feature-subheading">
                {f.sections.motion.durationsTitle}
              </h3>
              <div class="scale-list">
                {motion.map(([name, val]) => (
                  <div class="scale-item feature-item">
                    <span class="text-label scale-name">--motion-{name}</span>
                    <span class="text-body-small scale-val">{val}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="sg-block">
              <h3 class="text-heading-case feature-subheading">{f.sections.motion.easingsTitle}</h3>
              <div class="easings-grid">
                <div class="easing-card">
