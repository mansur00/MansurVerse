---
// 404 Not Found page per docs/01-design/page-specs.md and docs/02-engineering/pages-and-routing.md.
// Served for all unrecognized routes.
import BaseLayout from '../layouts/BaseLayout.astro';
import SlashLabel from '../components/primitives/SlashLabel.astro';
import Button from '../components/primitives/Button.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout title={`404 | ${siteConfig.brand.primary}${siteConfig.brand.secondary}`} noindex={true}>
  <section class="not-found-section" aria-label="Page Not Found">
    <div class="not-found-container">
      <SlashLabel label="404" variant="on-light" />
      <h1 class="not-found-title text-display-hero">404</h1>
      <p class="not-found-text text-body">{siteConfig.notFound.text}</p>
      <div class="not-found-action">
        <Button href={siteConfig.notFound.button.href} variant="primary" showArrow={true}>
          {siteConfig.notFound.button.label}
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found-section {
    min-height: 70vh;
    padding: var(--space-12) var(--layout-page-gutter);
    background: var(--color-bg-base);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .not-found-container {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-6);
  }

  .not-found-title {
    margin: 0;
    line-height: 0.85;
  }

  .not-found-text {
    margin: 0;
    max-width: 36ch;
    color: var(--color-text-muted);
  }

  .not-found-action {
    margin-top: var(--space-4);
    display: flex;
  }
</style>

<script>
  const init = async () => {
    const { initNotFoundPage } = await import('../scripts/motion/not-found');
    initNotFoundPage();
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
  document.addEventListener('astro:page-load', init);
</script>
