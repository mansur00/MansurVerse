---
// 404 Not Found page per docs/01-design/page-specs.md and docs/01-design/layout-system.md.
// Served for all unrecognized routes.
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout-primitives/Section.astro';
import Stack from '../components/layout-primitives/Stack.astro';
import SlashLabel from '../components/primitives/SlashLabel.astro';
import Button from '../components/primitives/Button.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout title={`404 | ${siteConfig.brand.primary}${siteConfig.brand.secondary}`} noindex={true}>
  <Section surface="base" size="default" class="not-found-section" aria-label="Page Not Found">
    <Stack gap="base" class="not-found-stack">
      <SlashLabel label="404" variant="on-light" />
      <h1 class="not-found-title text-display-hero">404</h1>
      <p class="not-found-text text-body">{siteConfig.notFound.text}</p>
      <div class="not-found-action">
        <Button href={siteConfig.notFound.button.href} variant="primary" showArrow={true}>
          {siteConfig.notFound.button.label}
        </Button>
      </div>
    </Stack>
  </Section>
</BaseLayout>

<style>
  .not-found-section {
    min-height: 70vh;
    display: flex;
    align-items: center;
  }

  .not-found-stack {
    max-width: var(--measure-narrow, 34ch);
  }

  .not-found-title {
    margin: 0;
    line-height: 0.85;
  }

  .not-found-text {
    margin: 0;
    color: var(--color-text-muted);
  }

  .not-found-action {
    margin-top: var(--space-4);
    display: flex;
  }
</style>

<script>
  const init = async () => {
    const { initNotFoundPage } = await import('../scripts/motion/not-found');
    initNotFoundPage();
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
  document.addEventListener('astro:page-load', init);
</script>
