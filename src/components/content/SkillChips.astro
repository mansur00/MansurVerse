---
import Chip from '../primitives/Chip.astro';

interface Props {
  skills: Array<{
    name: string;
    variant?: 'filled' | 'accent' | 'outlined' | undefined;
  }>;
  surface?: 'base' | 'feature' | undefined;
  class?: string | undefined;
}

const { skills, surface = 'base', class: className = '' } = Astro.props;
---

<div class:list={['skill-chips-container', className]}>
  {skills.map((skill) => (
    <Chip variant={skill.variant ?? 'filled'} surface={surface}>
      {skill.name}
    </Chip>
  ))}
</div>

<style>
  .skill-chips-container {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  :global(.skill-chips-container .chip) {
    transition: transform var(--motion-fast) var(--ease-out);
  }

  :global(.skill-chips-container .chip:hover) {
    transform: translateY(-4px);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.skill-chips-container .chip:hover) {
      transform: none;
    }
  }

  :global(:root[data-motion='reduced'] .skill-chips-container .chip:hover) {
    transform: none;
  }
</style>
