---
import SuperscriptNumber from '../primitives/SuperscriptNumber.astro';
import Divider from '../primitives/Divider.astro';

interface Props {
  title: string;
  number: number | string;
  description: string;
  isOpen?: boolean | undefined;
  tags?: string[] | undefined;
  class?: string | undefined;
}

const {
  title,
  number,
  description,
  isOpen = false,
  tags = [],
  class: className = '',
} = Astro.props;
---

<div class:list={['capability-row-wrapper', className]}>
  <details class="capability-row" open={isOpen}>
    <summary class="row-summary">
      <div class="summary-left">
        <SuperscriptNumber number={number} class="row-num" />
        <h3 class="row-title text-heading-row">{title}</h3>
      </div>
      <span class="row-indicator" aria-hidden="true">
        +
      </span>
    </summary>

    <div class="row-content">
      <p class="row-desc text-body">{description}</p>
      {tags.length > 0 && (
        <ul class="row-tags" aria-label="Tools and skills">
          {tags.map((tag) => (
            <li class="row-tag text-body-small">{tag}</li>
          ))}
        </ul>
      )}
    </div>
  </details>
  <Divider variant="on-feature" />
</div>

<style>
  .capability-row-wrapper {
    width: 100%;
  }

  .capability-row {
    width: 100%;
    background: transparent;
    padding: var(--space-4) 0;
    transition: background var(--motion-fast) var(--ease-out);
  }

  .row-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .row-summary::-webkit-details-marker {
    display: none;
  }

  .summary-left {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .row-title {
    margin: 0;
    color: var(--color-text-on-feature);
    transition: color var(--motion-fast) var(--ease-out);
  }

  .row-summary:hover .row-title {
    color: var(--color-accent-primary);
  }

  .row-indicator {
    font-family: var(--font-label);
    font-size: var(--text-heading-case-size);
    font-weight: var(--font-weight-regular);
    color: var(--color-accent-primary);
    line-height: 1;
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .capability-row[open] .row-indicator {
    transform: rotate(45deg);
  }

  .row-content {
    padding-top: var(--space-4);
    padding-left: var(--space-6);
    padding-bottom: var(--space-3);
    display: grid;
    gap: var(--space-3);
  }

  .row-desc {
    margin: 0;
    color: var(--color-text-on-feature);
    opacity: 0.85;
    max-width: 50ch;
  }

  .row-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row-tag {
    color: var(--color-accent-primary);
    background: var(--color-bg-feature);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-none);
  }
</style>
