---
// Cluster primitive per docs/01-design/layout-system.md section 4.3.
// Horizontal wrapping flow with strict stack token gaps (chips, tags, links).
export type ClusterGap = 'tight' | 'base' | 'loose' | 'section';
export type ClusterAlign = 'start' | 'center' | 'end' | 'baseline';
export type ClusterJustify = 'start' | 'center' | 'end' | 'between';

interface Props {
  gap?: ClusterGap | undefined;
  align?: ClusterAlign | undefined;
  justify?: ClusterJustify | undefined;
  as?:
    'div' | 'section' | 'article' | 'aside' | 'header' | 'footer' | 'nav' | 'ul' | 'ol' | undefined;
  id?: string | undefined;
  class?: string | undefined;
}

const {
  gap = 'base',
  align = 'center',
  justify = 'start',
  as: Component = 'div',
  id,
  class: className = '',
} = Astro.props;
---

<Component
  id={id}
  class:list={[
    'layout-cluster',
    `cluster-gap-${gap}`,
    `cluster-align-${align}`,
    `cluster-justify-${justify}`,
    className,
  ]}
>
  <slot />
</Component>

<style>
  .layout-cluster {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    box-sizing: border-box;
  }

  .cluster-gap-tight {
    gap: var(--stack-tight);
  }

  .cluster-gap-base {
    gap: var(--stack-base);
  }

  .cluster-gap-loose {
    gap: var(--stack-loose);
  }

  .cluster-gap-section {
    gap: var(--stack-section);
  }

  .cluster-align-start {
    align-items: flex-start;
  }

  .cluster-align-center {
    align-items: center;
  }

  .cluster-align-end {
    align-items: flex-end;
  }

  .cluster-align-baseline {
    align-items: baseline;
  }

  .cluster-justify-start {
    justify-content: flex-start;
  }

  .cluster-justify-center {
    justify-content: center;
  }

  .cluster-justify-end {
    justify-content: flex-end;
  }

  .cluster-justify-between {
    justify-content: space-between;
  }
</style>
