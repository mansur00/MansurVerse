---
import SlashLabel from '../primitives/SlashLabel.astro';
import SuperscriptNumber from '../primitives/SuperscriptNumber.astro';
import Chip from '../primitives/Chip.astro';
import Divider from '../primitives/Divider.astro';
import summary from '../../styles/tokens/generated/tokens.summary.json';
import { styleguideFixtures } from '../../fixtures/styleguide';

const f = styleguideFixtures.sections.motion;
const motionTokens = Object.entries(summary.motion);
---

<section id="motion" class="sg-section sg-surface-feature" data-surface="feature">
  <div class="sg-section-content">
    <div class="sg-section-header">
      <SlashLabel label={f.label} variant="on-feature" />
      <h2 class="text-heading-section feature-title">
        {f.title}
        <SuperscriptNumber number={f.number} />
      </h2>
      <p class="text-body feature-intro">{f.intro}</p>
    </div>

    <!-- Durations & Easing Curves (Looped dynamically from summary.motion) -->
    <div class="sg-grid-2">
      <div class="sg-block">
        <h3 class="text-heading-case feature-subheading">{f.durationsTitle}</h3>
        <div class="scale-list">
          {motionTokens.map(([name, val]) => (
            <div class="scale-item feature-item">
              <span class="text-label scale-name">
                {f.motionPrefix}
                {name}
              </span>
              <span class="text-body-small scale-val">{val}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="sg-block">
        <h3 class="text-heading-case feature-subheading">{f.easingsTitle}</h3>
        <div class="easings-grid">
          <div class="easing-card">
            <div class="easing-svg-box">
              <svg viewBox="0 0 100 100" class="easing-svg" aria-hidden="true">
                <line x1="0" y1="100" x2="100" y2="0" class="easing-diagonal" />
                <path d="M 0 100 C 20 30, 20 0, 100 0" class="easing-curve" />
              </svg>
            </div>
            <span class="text-label easing-name">{f.easeOutLabel}</span>
            <span class="text-body-small easing-val">{summary.ease.out}</span>
          </div>

          <div class="easing-card">
            <div class="easing-svg-box">
              <svg viewBox="0 0 100 100" class="easing-svg" aria-hidden="true">
                <line x1="0" y1="100" x2="100" y2="0" class="easing-diagonal" />
                <path d="M 0 100 C 60 100, 20 0, 100 0" class="easing-curve" />
              </svg>
            </div>
            <span class="text-label easing-name">{f.easeInOutLabel}</span>
            <span class="text-body-small easing-val">{summary.ease['in-out']}</span>
          </div>
        </div>
      </div>
    </div>

    <Divider variant="on-feature" />

    <!-- Interactions Table -->
    <div class="sg-block">
      <h3 class="text-heading-case feature-subheading">{f.interactionsTitle}</h3>
      <p class="text-body-small feature-desc">{f.interactionsDesc}</p>

      <div class="interactions-list">
        {f.interactions.map((int) => (
          <div class="interaction-card">
            <div class="interaction-header">
              <div class="interaction-id-wrap">
                <span class="text-heading-job int-id">{int.id}</span>
                <h4 class="text-heading-job int-name">{int.name}</h4>
              </div>
              <div class="interaction-badges">
                <Chip variant="filled" surface="feature">
                  {int.category}
                </Chip>
                <Chip variant="accent" surface="feature">
                  {int.status}
                </Chip>
              </div>
            </div>
            <p class="text-body-small int-desc">{int.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .sg-section {
    width: 100%;
    padding: var(--layout-section-y) var(--layout-pad);
  }

  .sg-surface-feature {
    background: var(--color-bg-feature);
    color: var(--color-text-on-feature);
  }

  .sg-section-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .sg-section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .feature-title {
    color: var(--color-text-on-feature);
    margin: 0;
  }

  .feature-intro {
    color: var(--color-text-muted-on-feature);
    max-width: 65ch;
    margin: 0;
  }

  .sg-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .feature-subheading {
    color: var(--color-text-on-feature);
    margin: 0;
  }

  .feature-desc {
    color: var(--color-text-muted-on-feature);
    max-width: 65ch;
    margin: 0;
  }

  .sg-grid-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (width >= 721px) {
    .sg-grid-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .scale-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .scale-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-none);
  }

  .feature-item {
    background: var(--palette-dark-800);
  }

  .feature-item .scale-name {
    color: var(--color-text-on-feature);
  }

  .feature-item .scale-val {
    color: var(--color-accent-primary);
  }

  .easings-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .easing-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    background: var(--palette-dark-800);
    border-radius: var(--radius-none);
  }

  .easing-svg-box {
    width: 100%;
    aspect-ratio: 1;
    background: var(--color-bg-feature);
    padding: var(--space-2);
  }

  .easing-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .easing-diagonal {
    stroke: var(--palette-white-16);
    stroke-dasharray: 4 4;
  }

  .easing-curve {
    fill: none;
    stroke: var(--color-accent-primary);
  }

  .easing-name {
    color: var(--color-text-on-feature);
  }

  .easing-val {
    color: var(--color-accent-secondary-1);
  }

  .interactions-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (width >= 721px) {
    .interactions-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (width >= 1024px) {
    .interactions-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .interaction-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--palette-dark-800);
    border-radius: var(--radius-none);
  }

  .interaction-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .interaction-id-wrap {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .int-id {
    color: var(--color-accent-primary);
    margin: 0;
  }

  .int-name {
    color: var(--color-text-on-feature);
    margin: 0;
  }

  .interaction-badges {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .int-desc {
    color: var(--color-text-muted-on-feature);
    margin: 0;
  }
</style>
