---
// CompareSlider.astro: Native range input driving comparison clip-path (I-26)
interface Props {
  beforeImage?: string | undefined;
  afterImage?: string | undefined;
  beforeLabel?: string | undefined;
  afterLabel?: string | undefined;
  class?: string | undefined;
}

const {
  beforeImage = '',
  afterImage = '',
  beforeLabel = 'Before',
  afterLabel = 'After',
  class: className = '',
} = Astro.props;
---

<div
  class:list={['compare-slider', className]}
  data-motion="compare-slider"
  style="

--slider-pos: 50%;"
  aria-label="Before and after image comparison"
>
  <div class="compare-layer compare-before">
    {beforeImage ? (
      <img src={beforeImage} alt={beforeLabel} class="compare-image" loading="lazy" />
    ) : (
      <div class="compare-placeholder before-placeholder">
        <span class="placeholder-label text-label">{beforeLabel}</span>
      </div>
    )}
    <span class="compare-badge before-badge text-label">{beforeLabel}</span>
  </div>

  <div class="compare-layer compare-after">
    {afterImage ? (
      <img src={afterImage} alt={afterLabel} class="compare-image" loading="lazy" />
    ) : (
      <div class="compare-placeholder after-placeholder">
        <span class="placeholder-label text-label">{afterLabel}</span>
      </div>
    )}
    <span class="compare-badge after-badge text-label">{afterLabel}</span>
  </div>

  <div class="slider-handle" aria-hidden="true">
    <div class="handle-line"></div>
    <div class="handle-knob">
      <svg
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="currentColor"
        class="knob-icon"
        aria-hidden="true"
      >
        <path d="M4 8l3-3v6zM12 8l-3-3v6z"></path>
      </svg>
    </div>
  </div>

  <label for="compare-range" class="sr-only">
    {beforeLabel} / {afterLabel}
  </label>
  <input
    type="range"
    id="compare-range"
    class="compare-range-input"
    min="0"
    max="100"
    value="50"
    step="1"
    aria-label={`${beforeLabel} / ${afterLabel}`}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="50"
  />
</div>

<style>
  .compare-slider {
    position: relative;
    width: 100%;
    min-height: clamp(280px, 45vw, 560px);
    background: var(--color-bg-surface);
    overflow: hidden;
    user-select: none;
    touch-action: pan-y;
  }

  .compare-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .compare-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .compare-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .before-placeholder {
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
  }

  .after-placeholder {
    background: var(--color-bg-surface);
    color: var(--color-accent-primary);
  }

  .compare-badge {
    position: absolute;
    top: var(--space-4);
    padding: var(--space-1) var(--space-3);
    background: var(--palette-dark-900);
    color: var(--palette-white);
    border-radius: var(--radius-pill);
    pointer-events: none;
    z-index: 2;
  }

  .before-badge {
    left: var(--space-4);
  }

  .after-badge {
    right: var(--space-4);
  }

  .compare-after {
    clip-path: inset(0 0 0 calc(var(--slider-pos, 50%)));
  }

  .slider-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--slider-pos, 50%));
    width: 0;
    pointer-events: none;
    z-index: 3;
  }

  .handle-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(-1 * var(--line-handle) / 2);
    width: var(--line-handle);
    background: var(--color-focus);
    border-left: var(--line-hairline) solid var(--color-focus);
  }

  .handle-knob {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    background: var(--color-focus);
    color: var(--palette-black);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .knob-icon {
    width: 16px;
    height: 16px;
  }

  .compare-range-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    margin: 0;
    cursor: ew-resize;
    z-index: 4;
  }

  .compare-range-input:focus-visible ~ .slider-handle .handle-knob {
    outline: var(--line-focus-ring) solid var(--color-focus);
    outline-offset: var(--line-focus-offset);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
