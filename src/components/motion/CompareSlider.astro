---
// Phase 5 motion component placeholder to fulfill stylelint.config.mjs stroke exception
interface Props {
  beforeLabel?: string;
  afterLabel?: string;
  class?: string;
}

const { beforeLabel = 'Before', afterLabel = 'After', class: className = '' } = Astro.props;
---

<div class:list={['compare-slider', className]} aria-label="Compare before and after">
  <div class="slider-handle"></div>
  <span class="sr-only">
    {beforeLabel} / {afterLabel}
  </span>
</div>

<style>
  .compare-slider {
    position: relative;
    width: 100%;
    min-height: 200px;
    background: var(--color-bg-surface);
    overflow: hidden;
  }

  .slider-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--line-handle);
    background: var(--color-focus);
    border-left: var(--line-hairline) solid var(--color-focus);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
