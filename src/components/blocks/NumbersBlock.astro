---
// Shared Block: Numbers (used on Home, About, and Case study results)
// Feature surface with subtle dot grid texture and staggered StatTiles per docs/01-design/page-specs.md
import Section from '../layout-primitives/Section.astro';
import Grid from '../layout-primitives/Grid.astro';
import Cell from '../layout-primitives/Cell.astro';
import Stack from '../layout-primitives/Stack.astro';
import StatTile from '../content/StatTile.astro';
import statsData from '../../content/stats.json';
import homeData from '../../content/home.json';

interface StatItem {
  value: number;
  suffix: string;
  label: string;
  tone?: 'lime' | 'white' | undefined;
}

interface Props {
  headingLines?: string[] | undefined;
  lead?: string | undefined;
  stats?: StatItem[] | undefined;
  class?: string | undefined;
}

const {
  headingLines = homeData.numbers.heading,
  lead = homeData.numbers.lead,
  stats = statsData.items as StatItem[],
  class: className = '',
} = Astro.props;
---

<Section id="numbers" surface="feature-dots" size="default" class={className}>
  <Stack gap="section">
    <Stack gap="base" class="numbers-header">
      <h2 class="numbers-heading text-heading-section">{headingLines.join(' ')}</h2>
      {lead && <p class="numbers-lead text-body">{lead}</p>}
    </Stack>

    <Grid class="stats-grid">
      {stats.map((s, index) => {
        const formattedNumber = `${s.value}${s.suffix}`;
        const variant = s.tone ?? (index % 2 === 0 ? 'lime' : 'white');
        const staggered = index % 2 === 1;

        return (
          <Cell placement="meta" from="tablet" class="stat-cell">
            <StatTile
              number={formattedNumber}
              caption={s.label}
              variant={variant}
              staggered={staggered}
            />
          </Cell>
        );
      })}
    </Grid>
  </Stack>
</Section>

<style>
  .numbers-header {
    max-width: var(--measure-body, 60ch);
  }

  .numbers-heading {
    margin: 0;
    color: var(--color-text-on-feature);
  }

  .numbers-lead {
    margin: 0;
    color: var(--color-text-muted-on-feature);
  }

  @media (width < 721px) {
    .stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stat-cell {
      grid-column: span 1 !important;
    }
  }
</style>
