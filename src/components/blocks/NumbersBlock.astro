---
// Shared Block: Numbers (used on Home, About, and Case study results)
// Feature surface with subtle dot grid texture and staggered StatTiles per docs/01-design/page-specs.md
import StatTile from '../content/StatTile.astro';
import statsData from '../../content/stats.json';
import homeData from '../../content/home.json';

interface StatItem {
  value: number;
  suffix: string;
  label: string;
  tone?: 'lime' | 'white' | undefined;
}

interface Props {
  headingLines?: string[] | undefined;
  lead?: string | undefined;
  stats?: StatItem[] | undefined;
  class?: string | undefined;
}

const {
  headingLines = homeData.numbers.heading,
  lead = homeData.numbers.lead,
  stats = statsData.items as StatItem[],
  class: className = '',
} = Astro.props;
---

<section class:list={['numbers-block', className]} data-surface="feature">
  <div class="numbers-texture" aria-hidden="true"></div>

  <div class="block-container">
    <div class="numbers-header">
      <h2 class="numbers-heading text-heading-section">
        {headingLines.map((line, idx) => (
          <span class="heading-line">
            {line}
            {idx < headingLines.length - 1 && <br />}
          </span>
        ))}
      </h2>
      {lead && <p class="numbers-lead text-body">{lead}</p>}
    </div>

    <div class="stats-grid">
      {stats.map((s, index) => {
        const formattedNumber = `${s.value}${s.suffix}`;
        const variant = s.tone ?? (index % 2 === 0 ? 'lime' : 'white');
        const staggered = index % 2 === 1;

        return (
          <StatTile
            number={formattedNumber}
            caption={s.label}
            variant={variant}
            staggered={staggered}
          />
        );
      })}
    </div>
  </div>
</section>

<style>
  .numbers-block {
    position: relative;
    background: var(--color-bg-feature);
    color: var(--color-text-on-feature);
    padding: var(--space-12) var(--layout-page-gutter);
    overflow: hidden;
  }

  .numbers-texture {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(var(--color-divider-on-feature) 1px, transparent 1.5px);
    background-size: 18px 18px;
    background-position: 0 0;
    opacity: 0.8;
  }

  .block-container {
    position: relative;
    max-width: var(--layout-max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .numbers-header {
    max-width: 48ch;
  }

  .numbers-heading {
    margin: 0 0 var(--space-4);
    color: var(--color-text-on-feature);
  }

  .numbers-lead {
    margin: 0;
    color: var(--color-text-muted-on-feature);
    font-size: var(--text-body-size);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  @media (width < 900px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (width < 600px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
