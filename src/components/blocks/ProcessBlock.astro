---
// Shared Block: Process (used on Home, Work, Case study, and Contact)
// 4-step sequential reveal layout per docs/01-design/page-specs.md
import Section from '../layout-primitives/Section.astro';
import Grid from '../layout-primitives/Grid.astro';
import Cell from '../layout-primitives/Cell.astro';
import Stack from '../layout-primitives/Stack.astro';
import SlashLabel from '../primitives/SlashLabel.astro';
import ProcessStep from '../content/ProcessStep.astro';
import processData from '../../content/process.json';

interface Item {
  title: string;
  text: string;
}

interface Props {
  label?: string | undefined;
  items?: Item[] | undefined;
  surface?: 'base' | 'alt' | undefined;
  class?: string | undefined;
}

const {
  label = processData.label,
  items = processData.items,
  surface = 'base',
  class: className = '',
} = Astro.props;
---

<Section id="process" surface={surface} size="default" class={className}>
  <Stack gap="section">
    <div>
      <SlashLabel label={label} variant="on-light" />
    </div>

    <Grid class="process-grid">
      {items.map((item, index) => (
        <Cell placement="meta" from="tablet" class="process-cell">
          <ProcessStep stepNumber={index + 1} title={item.title} text={item.text} />
        </Cell>
      ))}
    </Grid>
  </Stack>
</Section>

<style>
  @media (width < 721px) {
    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .process-cell {
      grid-column: span 1 !important;
    }
  }
</style>
