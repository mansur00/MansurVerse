---
// Shared Block: Values (used on Home and About)
// Feature surface with large heading, KeywordTags, ValueRows and flat colour shapes per docs/01-design/page-specs.md
import Section from '../layout-primitives/Section.astro';
import Container from '../layout-primitives/Container.astro';
import Stack from '../layout-primitives/Stack.astro';
import KeywordTag from '../primitives/KeywordTag.astro';
import ValueRow from '../content/ValueRow.astro';
import valuesData from '../../content/values.json';
import homeData from '../../content/home.json';

interface Item {
  label: string;
  text: string;
}

interface Props {
  headingLines?: string[] | undefined;
  tags?: [string, string, string] | undefined;
  items?: Item[] | undefined;
  class?: string | undefined;
}

const {
  headingLines = homeData.values.heading,
  tags = homeData.values.tags as [string, string, string],
  items = valuesData.items,
  class: className = '',
} = Astro.props;
---

<Section id="values" surface="feature" size="default" class={className}>
  <Container>
    <Stack gap="section">
      <div class="values-header">
        <h2 class="values-heading text-heading-section">
          {headingLines.map((line, idx) => (
            <span class="heading-line">
              {line}
              {idx < headingLines.length - 1 && <br />}
            </span>
          ))}
        </h2>

        <div class="values-tags" aria-hidden="true">
          {tags.map((tag, idx) => (
            <KeywordTag tagIndex={((idx % 4) + 1) as 1 | 2 | 3 | 4}>{tag}</KeywordTag>
          ))}
        </div>

        <div class="decorative-shapes" aria-hidden="true">
          <div class="shape-lime"></div>
          <div class="shape-pink"></div>
        </div>
      </div>

      <div class="values-list">
        {items.map((item) => (
          <ValueRow slashLabel={item.label} text={item.text} variant="on-feature" />
        ))}
      </div>
    </Stack>
  </Container>
</Section>

<style>
  .values-header {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
  }

  .values-heading {
    margin: 0;
    color: var(--color-text-on-feature);
  }

  .values-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .decorative-shapes {
    position: absolute;
    right: 0;
    top: 0;
    pointer-events: none;
    display: flex;
    gap: var(--space-2);
  }

  .shape-lime {
    width: 32px;
    height: 32px;
    background: var(--color-accent-primary);
  }

  .shape-pink {
    width: 24px;
    height: 48px;
    background: var(--palette-pink);
  }

  .values-list {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
</style>
