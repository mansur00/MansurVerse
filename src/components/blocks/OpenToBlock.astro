---
// Shared Block: Open to (used on About and Contact)
// Career/project engagement rows with "Let's talk" action per docs/01-design/page-specs.md
import SlashLabel from '../primitives/SlashLabel.astro';
import JobRow from '../content/JobRow.astro';
import openToData from '../../content/open-to.json';

interface Item {
  category: string;
  title: string;
  meta: string;
}

interface Props {
  label?: string | undefined;
  items?: Item[] | undefined;
  ctaLabel?: string | undefined;
  ctaHref?: string | undefined;
  surface?: 'base' | 'alt' | undefined;
  class?: string | undefined;
}

const {
  label = openToData.label,
  items = openToData.items,
  ctaLabel = 'Let’s talk',
  ctaHref = '/contact',
  surface = 'base',
  class: className = '',
} = Astro.props;

const isAlt = surface === 'alt';
---

<section class:list={['open-to-block', { 'is-alt': isAlt }, className]} data-surface={surface}>
  <div class="block-container">
    <div class="block-header">
      <SlashLabel label={label} variant="on-light" />
    </div>

    <div class="jobs-list">
      {items.map((job) => (
        <JobRow
          category={job.category}
          title={job.title}
          meta={job.meta}
          ctaLabel={ctaLabel}
          ctaHref={ctaHref}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .open-to-block {
    background: var(--color-bg-base);
    color: var(--color-text-primary);
    padding: var(--space-12) var(--layout-page-gutter);
  }

  .open-to-block.is-alt {
    background: var(--color-bg-alt);
  }

  .block-container {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .block-header {
    margin-bottom: var(--space-2);
  }

  .jobs-list {
    display: flex;
    flex-direction: column;
  }
</style>
