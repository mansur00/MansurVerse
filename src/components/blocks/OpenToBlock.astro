---
// Shared Block: Open to (used on About and Contact)
// Career/project engagement rows with "Let's talk" action per docs/01-design/page-specs.md
import Section from '../layout-primitives/Section.astro';
import Container from '../layout-primitives/Container.astro';
import Stack from '../layout-primitives/Stack.astro';
import SlashLabel from '../primitives/SlashLabel.astro';
import JobRow from '../content/JobRow.astro';
import openToData from '../../content/open-to.json';

interface Item {
  category: string;
  title: string;
  meta: string;
}

interface Props {
  label?: string | undefined;
  items?: Item[] | undefined;
  ctaLabel?: string | undefined;
  ctaHref?: string | undefined;
  surface?: 'base' | 'alt' | undefined;
  class?: string | undefined;
}

const {
  label = openToData.label,
  items = openToData.items,
  ctaLabel = 'Let’s talk',
  ctaHref = '/contact',
  surface = 'base',
  class: className = '',
} = Astro.props;
---

<Section id="open-to" surface={surface} size="default" class={className}>
  <Container>
    <Stack gap="section">
      <div class="block-header">
        <SlashLabel label={label} variant="on-light" />
      </div>

      <div class="jobs-list">
        {items.map((job) => (
          <JobRow
            category={job.category}
            title={job.title}
            meta={job.meta}
            ctaLabel={ctaLabel}
            ctaHref={ctaHref}
          />
        ))}
      </div>
    </Stack>
  </Container>
</Section>

<style>
  .block-header {
    margin-bottom: var(--space-2);
  }

  .jobs-list {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
</style>
