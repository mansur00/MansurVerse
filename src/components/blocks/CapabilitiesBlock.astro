---
// Shared Block: Capabilities (used on Home and Work)
// Feature surface with SlashLabel and accordion CapabilityRow items per docs/01-design/page-specs.md
import Section from '../layout-primitives/Section.astro';
import Container from '../layout-primitives/Container.astro';
import Stack from '../layout-primitives/Stack.astro';
import SlashLabel from '../primitives/SlashLabel.astro';
import CapabilityRow from '../content/CapabilityRow.astro';
import capabilitiesData from '../../content/capabilities.json';

interface Item {
  title: string;
  description: string;
}

interface Props {
  label?: string | undefined;
  items?: Item[] | undefined;
  class?: string | undefined;
}

const {
  label = capabilitiesData.label,
  items = capabilitiesData.items,
  class: className = '',
} = Astro.props;
---

<Section id="capabilities" surface="feature" size="default" class={className}>
  <Container>
    <Stack gap="section">
      <div class="block-header">
        <SlashLabel label={label} variant="on-feature" />
      </div>

      <div class="capabilities-list">
        {items.map((item, index) => (
          <CapabilityRow
            title={item.title}
            number={index + 1}
            description={item.description}
            isOpen={false}
          />
        ))}
      </div>
    </Stack>
  </Container>
</Section>

<style>
  .block-header {
    margin-bottom: var(--space-2);
  }

  .capabilities-list {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
</style>
