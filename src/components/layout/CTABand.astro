---
import Section from '../layout-primitives/Section.astro';
import Container from '../layout-primitives/Container.astro';
import Stack from '../layout-primitives/Stack.astro';
import SlashLabel from '../primitives/SlashLabel.astro';
import Button from '../primitives/Button.astro';

interface Props {
  slashLabel: string;
  heading: string;
  text: string;
  buttonLabel: string;
  buttonHref: string;
  variant?: 'on-base' | 'on-alt' | 'on-feature' | undefined;
  class?: string | undefined;
}

const {
  slashLabel,
  heading,
  text,
  buttonLabel,
  buttonHref,
  variant = 'on-base',
  class: className = '',
} = Astro.props;

const surfaceMap = {
  'on-base': 'base',
  'on-alt': 'alt',
  'on-feature': 'feature',
} as const;

const isFeature = variant === 'on-feature';
---

<Section surface={surfaceMap[variant]} size="default" class={className}>
  <Container>
    <Stack gap="base" class="cta-inner">
      <SlashLabel
        label={slashLabel}
        variant={isFeature ? 'on-feature' : 'on-light'}
        class="cta-label"
      />
      <h2 class:list={['cta-heading', 'text-heading-section', { 'text-feature': isFeature }]}>
        {heading}
      </h2>
      <p class:list={['cta-text', 'text-body', { 'text-muted-feature': isFeature }]}>{text}</p>
      <div class="cta-action">
        <Button href={buttonHref} variant="primary" showArrow={true}>
          {buttonLabel}
        </Button>
      </div>
    </Stack>
  </Container>
</Section>

<style>
  .cta-inner {
    max-width: var(--measure-body, 60ch);
  }

  .cta-heading {
    margin: 0;
    color: var(--color-text-primary);
  }

  .cta-heading.text-feature {
    color: var(--color-text-on-feature);
  }

  .cta-text {
    margin: 0;
    color: var(--color-text-muted);
  }

  .cta-text.text-muted-feature {
    color: var(--color-text-on-feature);
    opacity: 0.8;
  }

  .cta-action {
    margin-top: var(--space-3);
  }
</style>
