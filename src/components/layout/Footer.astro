---
import Section from '../layout-primitives/Section.astro';
import Stack from '../layout-primitives/Stack.astro';
import Divider from '../primitives/Divider.astro';
import MotionToggle from './MotionToggle.astro';

interface Props {
  pages: Array<{ label: string; href: string }>;
  socials: Array<{ label: string; href: string }>;
  localTimeLabel: string;
  timeZone: string;
  copyright: string;
  pagesTitle?: string | undefined;
  elsewhereTitle?: string | undefined;
  class?: string | undefined;
}

const {
  pages,
  socials,
  localTimeLabel,
  timeZone,
  copyright,
  pagesTitle = 'Pages',
  elsewhereTitle = 'Elsewhere',
  class: className = '',
} = Astro.props;
---

<Section as="footer" surface="base" size="none" class:list={['footer', className]}>
  <Stack gap="section" class="footer-stack">
    <div class="footer-columns">
      <div class="footer-col">
        <span class="col-title text-label">{pagesTitle}</span>
        <ul class="col-list">
          {pages.map((item) => (
            <li>
              <a href={item.href} class="footer-link text-body">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <span class="col-title text-label">{elsewhereTitle}</span>
        <ul class="col-list">
          {socials.map((item) => (
            <li>
              <a
                href={item.href}
                class="footer-link text-body"
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.label} ↗
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <span class="col-title text-label">{localTimeLabel}</span>
        <div class="time-block">
          <time class="time-value text-body" data-timezone={timeZone}>
            {timeZone}
          </time>
        </div>
      </div>
    </div>

    <Divider variant="on-base" class="footer-divider" />

    <div class="footer-bottom">
      <p class="copyright text-body-small">{copyright}</p>
      <MotionToggle />
    </div>
  </Stack>
</Section>

<style>
  .footer {
    width: 100%;
    padding-top: var(--layout-section-y);
    padding-bottom: var(--space-6);
  }

  .footer-stack {
    width: 100%;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    width: 100%;
  }

  @media (width >= 721px) {
    .footer-columns {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .footer-col {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .col-title {
    color: var(--color-text-muted);
  }

  .col-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .footer-link {
    text-decoration: none;
    color: var(--color-text-primary);
    transition: color var(--motion-fast) var(--ease-out);
  }

  .footer-link:hover {
    color: var(--color-accent-primary);
  }

  .time-block {
    display: flex;
    align-items: center;
  }

  .time-value {
    color: var(--color-text-primary);
  }

  .footer-divider {
    width: 100%;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
  }

  .copyright {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
