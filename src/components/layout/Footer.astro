---
// Footer component per docs/01-design/layout-system.md section 4.1 & section 6.
// Uses Section size="none" so its inline padding matches Nav and every page section.
import Section from '../layout-primitives/Section.astro';
import Grid from '../layout-primitives/Grid.astro';
import Cell from '../layout-primitives/Cell.astro';
import Stack from '../layout-primitives/Stack.astro';
import Divider from '../primitives/Divider.astro';
import MotionToggle from './MotionToggle.astro';

interface Props {
  pages: Array<{ label: string; href: string }>;
  socials: Array<{ label: string; href: string }>;
  localTimeLabel: string;
  timeZone: string;
  copyright: string;
  pagesTitle?: string | undefined;
  elsewhereTitle?: string | undefined;
  class?: string | undefined;
}

const {
  pages,
  socials,
  localTimeLabel,
  timeZone,
  copyright,
  pagesTitle = 'Pages',
  elsewhereTitle = 'Elsewhere',
  class: className = '',
} = Astro.props;
---

<Section as="footer" surface="base" size="none" class:list={['footer-section', className]}>
  <Stack gap="section" class="footer-stack">
    <Grid>
      <Cell placement="label" from="tablet" class="footer-col">
        <span class="col-title text-label">{pagesTitle}</span>
        <ul class="col-list">
          {pages.map((item) => (
            <li>
              <a href={item.href} class="footer-link text-body">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </Cell>

      <Cell placement="label" from="tablet" class="footer-col">
        <span class="col-title text-label">{elsewhereTitle}</span>
        <ul class="col-list">
          {socials.map((item) => (
            <li>
              <a
                href={item.href}
                class="footer-link text-body"
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.label} ↗
              </a>
            </li>
          ))}
        </ul>
      </Cell>

      <Cell placement="label" from="tablet" class="footer-col">
        <span class="col-title text-label">{localTimeLabel}</span>
        <div class="time-block">
          <time class="time-value text-body" data-timezone={timeZone}>
            {timeZone}
          </time>
        </div>
      </Cell>
    </Grid>

    <Divider variant="on-base" class="footer-divider" />

    <div class="footer-bottom">
      <p class="copyright text-body-small">{copyright}</p>
      <MotionToggle />
    </div>
  </Stack>
</Section>

<style>
  .footer-section {
    padding-top: var(--layout-section-y);
    padding-bottom: var(--space-6);
  }

  .footer-stack {
    width: 100%;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .col-title {
    color: var(--color-text-muted);
  }

  .col-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-link {
    text-decoration: none;
    color: var(--color-text-primary);
    transition: color var(--motion-fast) var(--ease-out);
  }

  .footer-link:hover {
    color: var(--color-accent);
  }

  .time-value {
    color: var(--color-text-primary);
    font-variant-numeric: tabular-nums;
  }

  .footer-divider {
    width: 100%;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
    justify-content: space-between;
  }

  @media (width >= 721px) {
    .footer-bottom {
      flex-direction: row;
      align-items: center;
    }
  }

  .copyright {
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
