---
interface Props {
  pauseLabel?: string | undefined;
  playLabel?: string | undefined;
  ariaLabel?: string | undefined;
  class?: string | undefined;
}

const {
  pauseLabel = 'Pause motion',
  playLabel = 'Play motion',
  ariaLabel = 'Toggle animations',
  class: className = '',
} = Astro.props;
---

<button
  type="button"
  id="motion-toggle"
  class:list={['motion-toggle', className]}
  aria-label={ariaLabel}
  data-motion-toggle
>
  <span class="motion-icon" aria-hidden="true">
    ◎
  </span>
  <span class="motion-label-pause">{pauseLabel}</span>
  <span class="motion-label-play">{playLabel}</span>
</button>

<style>
  .motion-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-body-small-size);
    cursor: pointer;
    transition: opacity var(--motion-fast) var(--ease-out);
  }

  .motion-toggle:hover {
    color: var(--color-text-primary);
  }

  .motion-label-play {
    display: none;
  }

  .motion-label-pause {
    display: inline;
  }

  :root[data-motion='reduced'] .motion-label-pause {
    display: none;
  }

  :root[data-motion='reduced'] .motion-label-play {
    display: inline;
  }
</style>
