---
interface Props {
  pauseLabel?: string | undefined;
  playLabel?: string | undefined;
  class?: string | undefined;
}

const {
  pauseLabel = 'Pause motion',
  playLabel = 'Play motion',
  class: className = '',
} = Astro.props;
---

<button
  type="button"
  id="motion-toggle"
  class:list={['motion-toggle', className]}
  data-motion-toggle
  aria-pressed="false"
>
  <span class="motion-icon" aria-hidden="true">
    ◎
  </span>
  <span class="motion-label-pause">{pauseLabel}</span>
  <span class="motion-label-play">{playLabel}</span>
</button>

<script>
  import {
    toggleMotionMode,
    isReducedMotion,
    MOTION_CHANGE_EVENT,
  } from '../../scripts/motion/context';

  function updateMotionToggleButtons(): void {
    const isReduced = isReducedMotion();
    document.querySelectorAll<HTMLButtonElement>('[data-motion-toggle]').forEach((btn) => {
      btn.setAttribute('aria-pressed', isReduced ? 'true' : 'false');
      const pauseLabel = btn.querySelector<HTMLElement>('.motion-label-pause');
      const playLabel = btn.querySelector<HTMLElement>('.motion-label-play');
      if (pauseLabel && playLabel) {
        pauseLabel.style.display = isReduced ? 'none' : 'inline';
        playLabel.style.display = isReduced ? 'inline' : 'none';
      }
    });
  }

  function initMotionToggles(): void {
    document.querySelectorAll<HTMLButtonElement>('[data-motion-toggle]').forEach((btn) => {
      if ((btn as HTMLElement & { __motionInit?: boolean }).__motionInit) return;
      (btn as HTMLElement & { __motionInit?: boolean }).__motionInit = true;

      btn.addEventListener('click', () => {
        toggleMotionMode();
        updateMotionToggleButtons();
      });
    });
    updateMotionToggleButtons();
  }

  if (typeof window !== 'undefined') {
    window.addEventListener(MOTION_CHANGE_EVENT, updateMotionToggleButtons);
    document.addEventListener('astro:page-load', initMotionToggles);
    initMotionToggles();
  }
</script>

<style>
  .motion-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-body-small-size);
    cursor: pointer;
    transition: opacity var(--motion-fast) var(--ease-out);
  }

  .motion-toggle:hover {
    color: var(--color-text-primary);
  }

  .motion-label-play {
    display: none;
  }

  .motion-label-pause {
    display: inline;
  }

  :global(:root[data-motion='reduced']) .motion-label-pause {
    display: none !important;
  }

  :global(:root[data-motion='reduced']) .motion-label-play {
    display: inline !important;
  }
</style>
