---
interface Props {
  tagIndex?: 1 | 2 | 3 | 4 | undefined;
  class?: string | undefined;
  style?: string | undefined;
}

const { tagIndex = 1, class: className = '', style = '' } = Astro.props;
---

<span class:list={['keyword-tag', `tag-${tagIndex}`, className]} style={style}>
  <slot />
</span>

<style>
  .keyword-tag {
    display: inline-block;
    padding: 6px 14px;
    border-radius: var(--radius-none);
    font-family: var(--font-body);
    font-size: var(--text-tag-size);
    font-weight: var(--text-tag-weight);
    line-height: var(--text-tag-line);
    letter-spacing: var(--text-tag-tracking);
    color: var(--tag-text);
    z-index: var(--z-tag);
    white-space: nowrap;
    transition: transform var(--motion-fast) var(--ease-out);
    user-select: none;
    animation: tag-float var(--motion-float) var(--ease-in-out) infinite alternate;
  }

  .keyword-tag:hover {
    transform: scale(1.15);
  }

  .tag-1 {
    background: var(--tag-bg-1);
    animation-delay: 0s;
  }

  .tag-2 {
    background: var(--tag-bg-2);
    animation-delay: -0.9s;
  }

  .tag-3 {
    background: var(--tag-bg-3);
    animation-delay: -1.8s;
  }

  .tag-4 {
    background: var(--tag-bg-4);
    animation-delay: -2.7s;
  }

  @keyframes tag-float {
    0% {
      transform: translateY(0) rotate(-2.5deg);
    }

    100% {
      transform: translateY(-10px) rotate(2.5deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .keyword-tag {
      animation: none;
    }
  }

  :root[data-motion='reduced'] .keyword-tag {
    animation: none;
  }
</style>
