{
  "name": "mansurverse-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run tokens:build && astro dev",
    "build": "pnpm run tokens:build && astro build && node scripts/strip-styleguide.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.{css,astro}\" --allow-empty-input",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens:build": "node scripts/tokens-build.mjs",
    "tokens:check": "node scripts/tokens-check.mjs",
    "test": "vitest run --passWithNoTests",
    "test:guardrails": "node scripts/test-guardrails.mjs",
    "test:e2e": "echo \"test:e2e arrives in Phase 4\"",
    "test:a11y": "echo \"test:a11y arrives in Phase 4\"",
    "lighthouse": "echo \"lighthouse arrives in Phase 7\"",
    "verify": "pnpm run tokens:check && pnpm run format:check && pnpm run check && pnpm run lint && pnpm run lint:css && pnpm run test:guardrails && pnpm run test && pnpm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,ts,astro}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,astro}": [
      "stylelint --fix"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
