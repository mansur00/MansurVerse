{
  "name": "mansurverse-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run tokens:build && astro dev",
    "build": "pnpm run tokens:build && astro build && node scripts/strip-styleguide.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.{css,astro}\" --allow-empty-input",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens:build": "node scripts/tokens-build.mjs",
    "tokens:check": "node scripts/tokens-check.mjs",
    "test": "vitest run --passWithNoTests",
    "test:guardrails": "node scripts/test-guardrails.mjs",
    "test:e2e": "echo \"test:e2e arrives in Phase 4\"",
    "test:a11y": "echo \"test:a11y arrives in Phase 4\"",
    "lighthouse": "echo \"lighthouse arrives in Phase 7\"",
    "verify": "pnpm run tokens:check && pnpm run format:check && pnpm run check && pnpm run lint && pnpm run lint:css && pnpm run test:guardrails && pnpm run test && pnpm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,ts,astro}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,astro}": [
      "stylelint --fix"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/stack-sans-notch": "^5.3.0",
    "@fontsource/jersey-20": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "ogl": "^1.0.11",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "postcss-html": "^2.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
